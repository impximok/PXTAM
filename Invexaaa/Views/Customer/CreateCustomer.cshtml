@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Invexaaa.Models.Invexa.Customer


@{
    ViewData["Title"] = "Create Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --bg: #fff;
        --card: #fff;
        --text: #111;
        --muted: #777;
        --border: #e6e6e6;
        --border-strong: #d6d6d6;
        --radius: 18px;
    }

    /* Force layout background to white (dashboard wrappers too) */
    html, body, main,
    .container-fluid, .content, .content-body,
    .app-content, .app-wrapper {
        background: #ffffff !important;
    }

    .page-wrap {
        min-height: calc(100vh - 120px);
        display: grid;
        place-items: center;
        align-items: start;
        padding: 20px 16px;
        padding-top: 12px; /* ⬅ moves whole frame up */
        background: var(--bg);
    }


    .card-clean {
        width: min(880px, 100%);
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .card-inner {
        padding: 18px 22px 22px;
    }

    .title {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: .2px;
        margin: 0;
        color: var(--text);
        line-height: 1.4;
    }

    .subtitle {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.4;
    }

    .divider {
        border: 0;
        border-top: 2px solid var(--border);
        margin: 20px 0 10px;
    }


    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 16px; /* tighter vertical spacing */
        align-items: start;
    }


    .field {
        margin: 0;
    }

    .span-2 {
        grid-column: 1 / -1;
    }

    .label {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 4px; /* tighter */
        font-size: 13px;
    }


    .req {
        color: #dc2626;
        font-weight: 400;
        margin-left: 4px;
    }

    .control {
        width: 100%;
        border: 2px solid var(--border) !important;
        border-radius: 16px !important;
        padding: 12px 14px !important; /* 👈 tighter */
        font-size: 15.5px !important;
        background: #fff !important;
        color: var(--text) !important;
        outline: none !important;
        box-shadow: none !important;
    }


        .control:focus {
            border-color: #000 !important;
        }

    textarea.control {
        min-height: 120px;
        resize: vertical;
    }

    /* Validation */
    .val {
        display: block;
        margin-top: 8px;
        font-size: 13px;
    }

    /* Red border when MVC adds input-validation-error */
    .control.input-validation-error {
        border-color: #dc2626 !important;
    }

        .control.input-validation-error:focus {
            border-color: #dc2626 !important;
        }

    /* Custom dropdown (same as your system) */
    .real-select {
        position: absolute !important;
        opacity: 0 !important;
        pointer-events: none !important;
        width: 1px !important;
        height: 1px !important;
    }

    .cs2 {
        position: relative;
    }

    .cs2-btn {
        width: 100%;
        border: 2px solid var(--border);
        border-radius: 18px;
        padding: 14px 44px 14px 16px;
        background: #fff;
        color: #111;
        font-size: 16px;
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
    }

    .cs2-caret {
        position: absolute;
        right: 18px;
        top: 50%;
        width: 9px;
        height: 9px;
        border-right: 2px solid #111;
        border-bottom: 2px solid #111;
        transform: translateY(-50%) rotate(45deg);
        pointer-events: none;
    }

    .cs2-menu {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 8px);
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 6px;
        z-index: 9999 !important;
        display: none;
    }

    .cs2.open .cs2-menu {
        display: block;
    }

    .cs2-item {
        width: 100%;
        text-align: left;
        border: 0;
        background: transparent;
        color: #111;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        margin: 2px 0;
    }

        .cs2-item:hover {
            background: #f2f2f2;
        }

    .cs2-btn:focus {
        border-color: #000 !important;
        outline: none;
    }

    .cs2.open .cs2-btn {
        border-color: #000 !important;
    }

    .real-select.input-validation-error ~ .cs2 .cs2-btn {
        border-color: #dc2626 !important;
    }

    /* Buttons */
    .actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-top: 12px;
    }

    .pill-btn {
        border-radius: 999px !important;
        padding: 14px 18px !important;
        font-weight: 800 !important;
        font-size: 16px !important;
        border: 2px solid #000 !important;
        text-align: center;
        user-select: none;
        transition: background-color 220ms ease, color 220ms ease, border-color 220ms ease;
    }

    .pill-solid {
        background: #000 !important;
        color: #fff !important;
    }

    .pill-outline {
        background: transparent !important;
        color: #000 !important;
        text-decoration: none !important;
    }

    .pill-solid:hover, .pill-solid:focus-visible {
        background: #fff !important;
        color: #000 !important;
        border-color: #000 !important;
    }

    .pill-outline:hover, .pill-outline:focus-visible {
        background: #000 !important;
        color: #fff !important;
        border-color: #000 !important;
        text-decoration: none !important;
    }

    @@media (max-width: 860px) {
        .card-inner {
            padding: 22px 18px 18px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .actions {
            grid-template-columns: 1fr;
        }
    }

    /* When select is invalid, highlight the visible cs2 button */
    select.input-validation-error + .cs2 .cs2-btn,
    .real-select.input-validation-error + .cs2 .cs2-btn {
        border-color: #dc2626 !important;
    }

    /* Optional: make dropdown text slightly red too */
    select.input-validation-error + .cs2 .cs2-value {
        color: #dc2626 !important;
    }

</style>

<div class="page-wrap">
    <div class="card-clean">
        <div class="card-inner">

            <h1 class="title">Create Customer</h1>
            <p class="subtitle">Add a new customer for stock-out tracking.</p>

            <hr class="divider" />

            <!-- Model-level errors -->
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form id="customerForm" asp-action="Create" asp-controller="Customer" method="post" novalidate>

                @Html.AntiForgeryToken()
                <input type="hidden" name="submitAction" id="submitAction" />


                <div class="form-grid">

                    <!-- Customer Name -->
                    <div class="field span-2">
                        <label asp-for="CustomerName" class="label">
                            Customer Name <span class="req">*</span>
                        </label>
                        <input asp-for="CustomerName" class="control" />
                        <span asp-validation-for="CustomerName" class="text-danger val"></span>
                    </div>

                    <!-- Phone -->
                    <div class="field">
                        <label asp-for="CustomerPhone" class="label">Phone</label>
                        <input asp-for="CustomerPhone"
                               class="control"
                               inputmode="numeric"
                               pattern="[0-9]*"
                               oninput="this.value = this.value.replace(/[^0-9]/g,'')" />
                        <span asp-validation-for="CustomerPhone" class="text-danger val"></span>
                    </div>

                    <!-- Status (⬅ moved UP) -->
                    <div class="field">
                        <label asp-for="CustomerStatus" class="label">
                            Status <span class="req">*</span>
                        </label>

                        <select asp-for="CustomerStatus" class="real-select" id="CustomerStatus">
                            <option value="">Select Status</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>

                        <div class="cs2" data-select="CustomerStatus">
                            <button type="button" class="cs2-btn">
                                <span class="cs2-value">Select Status</span>
                                <span class="cs2-caret"></span>
                            </button>

                            <div class="cs2-menu">
                                <button type="button" class="cs2-item" data-value="">Select Status</button>
                                <button type="button" class="cs2-item" data-value="Active">Active</button>
                                <button type="button" class="cs2-item" data-value="Inactive">Inactive</button>
                            </div>
                        </div>

                        <span asp-validation-for="CustomerStatus" class="text-danger val"></span>
                    </div>

                    <!-- Email (⬅ moved DOWN) -->
                    <div class="field span-2">
                        <label asp-for="CustomerEmail" class="label">Email</label>
                        <input asp-for="CustomerEmail" type="email" class="control" />
                        <span asp-validation-for="CustomerEmail" class="text-danger val"></span>
                    </div>


                    <!-- Address -->
                    <div class="field span-2">
                        <label asp-for="CustomerAddress" class="label">Address</label>
                        <textarea asp-for="CustomerAddress" class="control"></textarea>
                        <span asp-validation-for="CustomerAddress" class="text-danger val"></span>
                    </div>

                </div>


                <div class="actions">
                    <button type="submit"
                            class="pill-btn pill-solid js-submit"
                            data-action="save">
                        Save
                    </button>

                    <button type="submit"
                            class="pill-btn pill-outline js-submit"
                            data-action="saveNew">
                        Save &amp; New
                    </button>
                </div>


            </form>

        </div>
    </div>
</div>

<script>
    (() => {
      // Custom dropdown (CustomerStatus)
      const cs = document.querySelector('.cs2[data-select="CustomerStatus"]');
      if (!cs) return;

      const real = document.getElementById("CustomerStatus");
      const btn = cs.querySelector(".cs2-btn");
      const valueEl = cs.querySelector(".cs2-value");
      const items = Array.from(cs.querySelectorAll(".cs2-item"));

      const setActive = (val) => {
        valueEl.textContent = val || "Select Status";
        items.forEach(i => i.classList.toggle("active", i.dataset.value === val));
      };

      setActive(real.value);

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        cs.classList.toggle("open");
        btn.setAttribute("aria-expanded", cs.classList.contains("open") ? "true" : "false");
      });

      items.forEach(i => {
        i.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
    real.value = i.dataset.value;
    real.dispatchEvent(new Event("change", { bubbles: true }));
    real.dispatchEvent(new Event("blur", { bubbles: true }));

    // ✅ force jquery unobtrusive to validate immediately
    if (window.jQuery && window.jQuery.validator) {
      window.jQuery(real).valid();
    }

    setActive(i.dataset.value);


          cs.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
        });
      });

      document.addEventListener("click", e => {
        if (!cs.contains(e.target)) {
          cs.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
        }
      });
    })();

        (() => {
      // =========================
      // Save / Save & New logic
      // =========================
      const form = document.getElementById("customerForm");
      const hiddenAction = document.getElementById("submitAction");

      form.querySelectorAll(".js-submit").forEach(btn => {
        btn.addEventListener("click", () => {
          hiddenAction.value = btn.dataset.action;
        });
      });

      form.addEventListener("submit", () => {
        form.querySelectorAll(".js-submit").forEach(b => {
          b.disabled = true;
          if (b.dataset.action === hiddenAction.value) {
            b.textContent = "Saving...";
          }
        });
      });
    })();
</script>
