@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Invexaaa.Models.ViewModels.ItemCardViewModel>

@{
    ViewData["Title"] = "Manage Items";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string qVal = Context.Request.Query["search"];
    string catVal = Context.Request.Query["categoryId"];
    string stVal = Context.Request.Query["status"];
}

<style>
    :root {
        --bg: #ffffff;
        --border: #e6e7eb;
        --text: #111827;
        --muted: #6b7280;
        --radius: 18px;
    }

    html, body, main,
    .container-fluid, .content, .content-body,
    .app-content, .app-wrapper {
        background: #ffffff !important;
    }

    /* Full width page padding */
    .page-wrap {
        width: 100%;
        padding: 10px 18px 24px;
    }

    /* Header */
    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f0f0f0;
        margin-bottom: 12px;
        position: relative;
        z-index: 1000;
        pointer-events: auto;
    }

    .title {
        font-size: 34px;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.015em;
        margin: 0;
        color: var(--text);
    }

    .subtitle {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
    }

    /* Add button (icon) */
    .icon-btn {
        width: 44px;
        height: 44px;
        border: 2px solid #000 !important;
        background: #000 !important;
        color: #fff !important;
        border-radius: 999px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
        transition: background-color 220ms ease, color 220ms ease;
        user-select: none;
        white-space: nowrap;
        pointer-events: auto;
    }

        .icon-btn:hover, .icon-btn:focus-visible {
            background: #fff !important;
            color: #000 !important;
            outline: none;
        }

    /* Filters grid (Supplier style) */
    .filters {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr auto;
        gap: 10px 12px;
        align-items: end;
        padding: 18px 0 18px;
        border-bottom: 1.5px solid #e5e7eb;
        margin-bottom: 18px;
    }

    .label {
        font-weight: 600;
        color: #111;
        margin-bottom: 6px;
        font-size: 13px;
    }

    .control {
        width: 100%;
        border: 2px solid var(--border) !important;
        border-radius: 16px !important;
        padding: 11px 14px !important;
        height: 46px;
        font-size: 15px !important;
        background: #fff !important;
        color: var(--text) !important;
        outline: none !important;
        box-shadow: none !important;
    }

        .control:focus {
            border-color: #000 !important;
        }

    .filter-actions {
        display: inline-flex;
        gap: 10px;
        align-items: center;
        justify-content: flex-end;
        align-self: flex-end;
        margin-bottom: 2px;
    }

    .pill-btn {
        border-radius: 999px !important;
        padding: 8px 14px !important;
        font-size: 14px !important;
        font-weight: 700 !important;
        border: 2px solid #000 !important;
        background: transparent !important;
        color: #000 !important;
        white-space: nowrap;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color 220ms ease, color 220ms ease;
    }

    .pill-solid {
        background: #000 !important;
        color: #fff !important;
    }

        .pill-solid:hover, .pill-solid:focus-visible {
            background: #fff !important;
            color: #000 !important;
            outline: none;
        }

    .pill-outline:hover, .pill-outline:focus-visible {
        background: #000 !important;
        color: #fff !important;
        outline: none;
    }

    /* ===== Custom Select (cs2) ===== */
    .real-select {
        position: absolute !important;
        opacity: 0 !important;
        pointer-events: none !important;
        width: 1px !important;
        height: 1px !important;
    }

    .cs2 {
        position: relative;
    }

    .cs2-btn {
        width: 100%;
        border: 2px solid var(--border);
        border-radius: 16px;
        padding: 11px 40px 11px 14px;
        height: 46px;
        background: #fff;
        color: #111;
        font-size: 15px;
        font-weight: 500;
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
    }

    .cs2-value {
        flex: 1;
        text-align: left;
    }

    .cs2-btn:focus,
    .cs2.open .cs2-btn {
        border-color: #000 !important;
        outline: none;
    }

    .cs2-caret {
        position: absolute;
        right: 14px;
        top: 50%;
        width: 8px;
        height: 8px;
        border-right: 2px solid #111;
        border-bottom: 2px solid #111;
        transform: translateY(-50%) rotate(45deg);
        pointer-events: none;
    }

    .cs2-menu {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 8px);
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 6px;
        z-index: 9999;
        display: none;
    }

    .cs2.open .cs2-menu {
        display: block;
    }

    .cs2-item {
        width: 100%;
        text-align: left;
        border: 0;
        background: transparent;
        color: #111;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        margin: 2px 0;
        font-weight: 700;
        font-size: 13px;
    }

        .cs2-item:hover {
            background: #f2f2f2;
        }

    /* ===== Barcode card (system shell) ===== */
    .scan-shell {
        border: 2px solid #e5e7eb;
        border-radius: var(--radius);
        background: #fff;
        padding: 16px;
        margin: 8px 0 18px;
        max-width: 520px;
    }

    .scan-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 10px;
        align-items: end;
        margin-top: 8px;
    }

    .mini-hint {
        margin-top: 8px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 500;
    }

    /* ===== Grid shell ===== */
    .grid-shell {
        padding-top: 6px;
    }

    .empty-state {
        text-align: center;
        padding: 48px 0;
        color: var(--muted);
        font-size: 14px;
    }

    /* Pagination */
    .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid #f0f0f0;
    }

    .pagination .page-link {
        border-radius: 999px !important;
        border: 1px solid #e5e7eb !important;
        color: #111 !important;
        padding: 6px 12px;
    }

    .pagination .page-item.active .page-link {
        background: #111 !important;
        border-color: #111 !important;
        color: #fff !important;
    }

    @@media (max-width: 980px) {
        .filters {
            grid-template-columns: 1fr 1fr;
        }

        .filter-actions {
            grid-column: 1 / -1;
            justify-content: flex-start;
        }

        .scan-row {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .filters {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            width: 100%;
        }

        .pill-btn {
            width: 100%;
        }
    }

    .pill-btn {
        text-decoration: none !important;
    }
    /* ===== Pagination (Invexa style) ===== */
    .pagination {
        gap: 6px;
    }

        .pagination .page-item {
            margin: 0;
        }

        .pagination .page-link {
            min-width: 38px;
            height: 38px;
            padding: 0 14px;
            border-radius: 999px !important;
            border: 1.5px solid #e5e7eb !important;
            background: #fff !important;
            color: #111 !important;
            font-size: 14px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background-color .18s ease, color .18s ease, border-color .18s ease;
        }

            /* Hover */
            .pagination .page-link:hover {
                background: #f4f4f5 !important;
                border-color: #000 !important;
            }

        /* Active (current page) */
        .pagination .page-item.active .page-link {
            background: #000 !important;
            border-color: #000 !important;
            color: #fff !important;
        }

        /* Disabled */
        .pagination .page-item.disabled .page-link {
            background: #f3f4f6 !important;
            color: #9ca3af !important;
            border-color: #e5e7eb !important;
            cursor: not-allowed;
        }

    /* ===============================
           Paging bar (INVEXA style like Stock Tx)
        =============================== */
    .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 18px;
        padding: 12px 14px;
        border-top: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 18px;
    }

    .pager-left {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* compact, business-friendly range pill */
    .pager-range {
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid #e5e7eb;
        font-size: 13px;
        font-weight: 800;
        color: #111;
        background: #fff;
        letter-spacing: .2px;
    }

    .pager-label {
        font-size: 12px;
        font-weight: 800;
        color: var(--muted);
        letter-spacing: .25px;
        white-space: nowrap;
    }

    /* right side buttons */
    .pager-right {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    /* pill page button */
    .pager-btn {
        height: 38px;
        min-width: 38px;
        padding: 0 12px;
        border-radius: 999px;
        border: 2px solid #000;
        background: #fff;
        color: #000;
        font-size: 13px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
        cursor: pointer;
        transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease;
    }

        .pager-btn:hover,
        .pager-btn:focus-visible {
            background: #000;
            color: #fff;
            outline: none;
        }

        .pager-btn.is-active {
            background: #000;
            color: #fff;
        }

        .pager-btn.is-disabled,
        .pager-btn[aria-disabled="true"] {
            opacity: .35;
            cursor: not-allowed;
            pointer-events: none;
        }

    /* ===== Rows per page: reuse cs2 but compact ===== */
    .pager-cs2 .cs2-btn {
        height: 38px;
        min-width: 92px;
        border-radius: 999px;
        border: 2px solid #000;
        background: #fff;
        color: #111;
        font-size: 13px;
        font-weight: 900;
        padding: 0 40px 0 14px;
    }

    .pager-cs2 .cs2-menu {
        left: 0;
        right: 0;
        top: calc(100% + 8px);
        border-radius: 14px;
        padding: 6px;
        box-shadow: 0 16px 45px rgba(0,0,0,.14);
        z-index: 99999;
    }



    .pager-dots {
        color: var(--muted);
        font-weight: 800;
        padding: 0 6px;
    }

    /* mobile stack */
    @@media (max-width: 700px) {
        .pager {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .pager-right {
            width: 100%;
            justify-content: flex-start;
        }
    }

    /* cs2 flip mode */
    .cs2.open-up .cs2-menu {
        top: auto !important;
        bottom: calc(100% + 8px) !important;
    }

    .pager-range {
        display: inline-flex;
        align-items: center;
        letter-spacing: .1px;
        white-space: nowrap;
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid var(--border);
        font-size: 12px;
        font-weight: 600;
        background: var(--soft);
        color: #111;
    }


    /* pager outer shell = crisp card */
    .pager {
        background: #fff !important;
        border: 2px solid var(--border) !important; /* stronger border */
        border-radius: 18px !important;
        box-shadow: none !important; /* remove any fade shadow */
        overflow: hidden; /* clean edges */
    }

    .grid-shell, .page-wrap {
        background: #fff !important;
    }

</style>

<div class="page-wrap">

    <!-- Header -->
    <div class="page-head">
        <div>
            <h1 class="title">Manage Items</h1>
            <p class="subtitle">Search, filter and manage items.</p>
        </div>

        <div class="d-flex align-items-center gap-2">

            <!-- Export -->
            <a asp-controller="Item"
               asp-action="Export"
               class="pill-btn pill-outline"
               title="Export Items">
                Export
            </a>

            <!-- Import -->
            <form asp-controller="Item"
                  asp-action="Import"
                  method="post"
                  enctype="multipart/form-data"
                  class="d-inline">
                @Html.AntiForgeryToken()

                <label class="pill-btn pill-outline mb-0"
                       title="Import Items"
                       style="cursor:pointer;">
                    Import
                    <input type="file"
                           name="file"
                           accept=".xlsx,.csv"
                           hidden
                           onchange="this.form.submit();" />
                </label>
            </form>

            <!-- Create Item -->
            <a asp-controller="Item"
               asp-action="CreateItem"
               class="icon-btn"
               title="Add Item"
               aria-label="Add Item">
                <i class="bi bi-plus-lg"></i>
            </a>

        </div>

    </div>



    <!-- Filter Bar (system style) -->
    <form method="get" asp-controller="Item" asp-action="ItemIndex" class="filters" id="filterForm">


        <!-- Search -->
        <div>
            <div class="label">Item</div>
            <input id="q"
                   type="text"
                   name="search"
                   class="control"
                   placeholder="Search by name or barcode"
                   value="@qVal" />
        </div>

        <!-- Category (cs2) -->
        <div>
            <div class="label">Category</div>

            <select class="real-select" id="CategorySelect" name="categoryId">
                <option value="">All Categories</option>
                @foreach (var c in ViewBag.Categories)
                {
                    <option value="@c.CategoryID"
                            selected="@(catVal == c.CategoryID.ToString())">
                        @c.CategoryName
                    </option>
                }
            </select>

            <div class="cs2" data-select="CategorySelect">
                <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                    <span class="cs2-value">All Categories</span>
                    <span class="cs2-caret"></span>
                </button>

                <div class="cs2-menu" role="listbox">
                    <button type="button" class="cs2-item" data-value="">All Categories</button>
                    @foreach (var c in ViewBag.Categories)
                    {
                        <button type="button" class="cs2-item" data-value="@c.CategoryID">@c.CategoryName</button>
                    }
                </div>
            </div>
        </div>

        <!-- Status (cs2) -->
        <div>
            <div class="label">Status</div>

            <select class="real-select" id="StatusSelect" name="status">
                <option value="">All</option>
                @foreach (var s in ViewBag.StatusList)
                {
                    <option value="@s" selected="@(stVal == s)">@s</option>
                }
            </select>

            <div class="cs2" data-select="StatusSelect">
                <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                    <span class="cs2-value">All</span>
                    <span class="cs2-caret"></span>
                </button>

                <div class="cs2-menu" role="listbox">
                    <button type="button" class="cs2-item" data-value="">All</button>
                    @foreach (var s in ViewBag.StatusList)
                    {
                        <button type="button" class="cs2-item" data-value="@s">@s</button>
                    }
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="filter-actions">
            <button class="pill-btn pill-solid" type="submit">
                Filter
            </button>

            <a class="pill-btn pill-outline"
               href="/Item/ItemIndex"
               role="button">
                Reset
            </a>
        </div>
    </form>

    <!-- Item Grid -->
    <div class="grid-shell">
        <div class="row g-4">
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="empty-state">
                        <h5 style="margin:0; font-weight:800; color:#111;">No items found</h5>
                        <p style="margin:10px 0 0;">Try adjusting your search or filters.</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <partial name="_ItemCard" model="item" />
                    </div>
                }

            }
        </div>
    </div>

    <!-- Pagination (keep your server pagination later; this is UI shell) -->
    <div class="pager">
        @{
            int page = ViewBag.Page ?? 1;
            int pageSize = ViewBag.PageSize ?? 12;
            int total = ViewBag.TotalCount ?? Model.Count();
            int totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));

            int start = total == 0 ? 0 : ((page - 1) * pageSize) + 1;
            int end = Math.Min(page * pageSize, total);

            // paging window
            int window = 5; // how many numbers shown in middle
            int startP = Math.Max(1, page - window / 2);
            int endP = Math.Min(totalPages, startP + window - 1);
            startP = Math.Max(1, endP - window + 1);

            bool hasPrev = page > 1;
            bool hasNext = page < totalPages;
        }

        <div class="pager-left">
            <span class="pager-range">
                Showing @start–@end of @total
            </span>

            <span class="pager-label">Rows per page</span>

            <!-- real select -->
            <select class="real-select" id="PageSizeSelect" name="pageSize">
                <option value="48" selected="@(pageSize == 48)">48</option>
                <option value="96" selected="@(pageSize == 96)">96</option>
                <option value="150" selected="@(pageSize == 150)">150</option>
                <option value="300" selected="@(pageSize == 300)">300</option>
            </select>

            <!-- custom select -->
            <div class="cs2 pager-cs2" data-select="PageSizeSelect">
                <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                    <span class="cs2-value">@pageSize</span>
                    <span class="cs2-caret"></span>
                </button>

                <div class="cs2-menu" role="listbox">
                    <button type="button" class="cs2-item" data-value="48">48</button>
                    <button type="button" class="cs2-item" data-value="96">96</button>
                    <button type="button" class="cs2-item" data-value="150">150</button>
                    <button type="button" class="cs2-item" data-value="300">300</button>
                </div>
            </div>
        </div>


        <div class="pager-right">
            <!-- Prev -->
            <a class="pager-btn @(hasPrev ? "" : "is-disabled")"
               asp-controller="Item"
               asp-action="ItemIndex"
               asp-route-page="@(page - 1)"
               asp-route-pageSize="@pageSize"
               asp-route-search="@qVal"
               asp-route-categoryId="@catVal"
               asp-route-status="@stVal"
               aria-disabled="@(hasPrev ? "false" : "true")">
                Prev
            </a>

            <!-- First + dots -->
            @if (startP > 1)
            {
                <a class="pager-btn @(page == 1 ? "is-active" : "")"
                   asp-controller="Item"
                   asp-action="ItemIndex"
                   asp-route-page="1"
                   asp-route-pageSize="@pageSize"
                   asp-route-search="@qVal"
                   asp-route-categoryId="@catVal"
                   asp-route-status="@stVal">1</a>

                if (startP > 2)
                {
                    <span class="pager-dots">…</span>
                }
            }

            <!-- Middle window -->
            @for (int p = startP; p <= endP; p++)
            {
                <a class="pager-btn @(p == page ? "is-active" : "")"
                   asp-controller="Item"
                   asp-action="ItemIndex"
                   asp-route-page="@p"
                   asp-route-pageSize="@pageSize"
                   asp-route-search="@qVal"
                   asp-route-categoryId="@catVal"
                   asp-route-status="@stVal">@p</a>
            }

            <!-- Last + dots -->
            @if (endP < totalPages)
            {
                if (endP < totalPages - 1)
                {
                    <span class="pager-dots">…</span>
                }

                <a class="pager-btn @(page == totalPages ? "is-active" : "")"
                   asp-controller="Item"
                   asp-action="ItemIndex"
                   asp-route-page="@totalPages"
                   asp-route-pageSize="@pageSize"
                   asp-route-search="@qVal"
                   asp-route-categoryId="@catVal"
                   asp-route-status="@stVal">@totalPages</a>
            }

            <!-- Next -->
            <a class="pager-btn @(hasNext ? "" : "is-disabled")"
               asp-controller="Item"
               asp-action="ItemIndex"
               asp-route-page="@(page + 1)"
               asp-route-pageSize="@pageSize"
               asp-route-search="@qVal"
               asp-route-categoryId="@catVal"
               asp-route-status="@stVal"
               aria-disabled="@(hasNext ? "false" : "true")">
                Next
            </a>
        </div>
    </div>


</div>

@if (TempData["Success"] != null)
{
    <script>
        alert("@TempData["Success"]");
    </script>
}

<script>
    (() => {

      /* =========================================================
         CS2 (Custom Select) - FIXED dropdown (no clipping) + flip
         Works for:
         - Filters cs2 (Category/Status)
         - Pager cs2 (Rows per page)
      ========================================================== */
      function setupCS2(cs) {
        const selectId = cs.dataset.select;
        const real = document.getElementById(selectId);
        if (!real) return;

        const btn = cs.querySelector(".cs2-btn");
        const valueEl = cs.querySelector(".cs2-value");
        const items = Array.from(cs.querySelectorAll(".cs2-item"));
        const menu = cs.querySelector(".cs2-menu");
        if (!btn || !valueEl || !menu || items.length === 0) return;

        const setActive = (val) => {
          items.forEach(x => x.classList.remove("is-selected"));
          const found = items.find(i => String(i.dataset.value) === String(val));
          if (found) found.classList.add("is-selected");
          valueEl.textContent = found ? found.textContent : (items[0]?.textContent || "Select");
        };

        const cleanupFixedMenu = () => {
          // restore default CSS positioning
          menu.style.position = "";
          menu.style.left = "";
          menu.style.top = "";
          menu.style.bottom = "";
          menu.style.width = "";
          menu.style.maxHeight = "";
          menu.style.right = "";
          menu.style.zIndex = "";
        };

        const positionFixedMenu = () => {
          // ✅ fixed so it ignores clipping parents
          const rect = btn.getBoundingClientRect();

          menu.style.position = "fixed";
          menu.style.left = rect.left + "px";
          menu.style.width = rect.width + "px";
          menu.style.right = "auto";
          menu.style.zIndex = "999999";

          // reset
          menu.style.top = "auto";
          menu.style.bottom = "auto";
          menu.style.maxHeight = "";

          const spaceBelow = window.innerHeight - rect.bottom;
          const spaceAbove = rect.top;

          // measure menu height
          menu.style.display = "block";
          menu.style.visibility = "hidden";
          const menuH = menu.scrollHeight || 240;
          menu.style.visibility = "";
          menu.style.display = "";

          const desired = Math.min(320, menuH);
          const openUp = spaceBelow < Math.min(220, desired) && spaceAbove > spaceBelow;

          if (openUp) {
            menu.style.bottom = (window.innerHeight - rect.top + 8) + "px";
            menu.style.maxHeight = Math.max(140, Math.min(desired, spaceAbove - 16)) + "px";
          } else {
            menu.style.top = (rect.bottom + 8) + "px";
            menu.style.maxHeight = Math.max(140, Math.min(desired, spaceBelow - 16)) + "px";
          }
        };

        const close = () => {
          cs.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
          cleanupFixedMenu();
        };

        // initial label
        setActive(real.value);

        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();

          const willOpen = !cs.classList.contains("open");

          // close other dropdowns first
          document.querySelectorAll(".cs2.open").forEach(other => {
            if (other !== cs) {
              other.classList.remove("open");
              other.querySelector(".cs2-btn")?.setAttribute("aria-expanded", "false");
              const m = other.querySelector(".cs2-menu");
              if (m) {
                m.style.position = "";
                m.style.left = "";
                m.style.top = "";
                m.style.bottom = "";
                m.style.width = "";
                m.style.maxHeight = "";
                m.style.right = "";
                m.style.zIndex = "";
              }
            }
          });

          cs.classList.toggle("open", willOpen);
          btn.setAttribute("aria-expanded", willOpen ? "true" : "false");

          if (willOpen) positionFixedMenu();
          else cleanupFixedMenu();
        });

        items.forEach(i => {
          i.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();

            real.value = i.dataset.value ?? "";
            real.dispatchEvent(new Event("change", { bubbles: true }));
            setActive(real.value);

            // ✅ if this is pager "rows per page", auto navigate with querystring
            if (selectId === "PageSizeSelect") {
              // keep current filters/search, reset page to 1
              const url = new URL(window.location.href);
              url.searchParams.set("pageSize", real.value);
              url.searchParams.set("page", "1");
              window.location.href = url.toString();
              return;
            }

            close();
          });
        });

        // click outside closes
        document.addEventListener("click", (e) => {
          if (!cs.contains(e.target)) close();
        });

        // escape closes
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && cs.classList.contains("open")) close();
        });

        // keep aligned when scrolling/resizing
        window.addEventListener("scroll", () => {
          if (cs.classList.contains("open")) positionFixedMenu();
        }, true);

        window.addEventListener("resize", () => {
          if (cs.classList.contains("open")) positionFixedMenu();
        });
      }

      // init all cs2
      document.querySelectorAll(".cs2[data-select]").forEach(setupCS2);

    })();
</script>


