@model Invexaaa.Models.Invexa.ViewModels.ItemUnitsViewModel
@using Invexaaa.Models.Invexa.Enums
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Unit Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="max-width:900px">

    <!-- HEADER -->
    <div class="mb-4">
        <h2 style="font-weight:800">Units & Conversion</h2>
        <div style="color:#6b7280">
            Item: <b>@Model.ItemName</b> · Costing: <b>@Model.CostingMethod</b>
        </div>
    </div>

    <!-- COSTING WARNING -->
    @if (Model.CostingMethod == CostingMethod.Fixed ||
        Model.CostingMethod == CostingMethod.WeightedAverage)
    {
        <div class="alert alert-warning">
            <b>Important:</b> This item uses <b>@Model.CostingMethod</b> costing.
            A <b>base unit is mandatory</b>, and units cannot be removed once stock exists.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            FIFO allows multiple units. Quantities will be converted to the base unit internally.
        </div>
    }

    <!-- UNIT TABLE -->
    <div class="card mb-4">
        <div class="card-header">
            <b>Defined Units</b>
        </div>

        <div class="card-body p-0">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Unit Name</th>
                        <th>Multiplier → Base</th>
                        <th>Type</th>
                        <th style="width:120px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Units)
                    {
                        <tr>
                            <td>@u.UnitName</td>
                            <td>@u.BaseUnitMultiplier</td>
                            <td>
                                @if (u.IsBaseUnit)
                                {
                                    <span class="badge bg-dark">Base Unit</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Derived</span>
                                }
                            </td>
                            <td>
                                @if (u.IsBaseUnit)
                                {
                                    <span class="text-muted">Locked</span>
                                }
                                else if (Model.HasStock)
                                {
                                    <span class="text-muted">In use</span>
                                }
                                else
                                {
                                    <form asp-action="DeleteUnit"
                                          asp-controller="Item"
                                          method="post"
                                          class="d-inline">
                                        <input type="hidden" name="unitId" value="@u.ItemUnitConversionID" />
                                        <input type="hidden" name="itemId" value="@Model.ItemID" />
                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete this unit?')">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ADD UNIT -->
    <div class="card">
        <div class="card-header">
            <b>Add Unit</b>
        </div>

        <div class="card-body">
            <form asp-action="AddUnit" asp-controller="Item" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="ItemID" value="@Model.ItemID" />

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Unit Name</label>
                        <input name="NewUnitName"
                               class="form-control"
                               placeholder="e.g. kg, pack"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Multiplier to Base</label>
                        <input name="NewBaseUnitMultiplier"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="e.g. 1000"
                               required />
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                       
                    </div>
                </div>

                <div class="mt-3">
                    <button class="btn btn-dark">
                        Add Unit
                    </button>
                    <a asp-action="ItemDetail"
                       asp-route-id="@Model.ItemID"
                       class="btn btn-outline-secondary ms-2">
                        Back to Item
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>
