@model IEnumerable<Invexaaa.Models.ViewModels.StockViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Manage Stock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --bg: #ffffff;
        --border: #e6e7eb;
        --text: #111827;
        --muted: #6b7280;
        --radius: 18px;
        --table-edge-pad: 18px;
    }

    html, body, main,
    .container-fluid, .content, .content-body,
    .app-content, .app-wrapper {
        background: #ffffff !important;
    }

    /* Full width page padding */
    .page-wrap {
        width: 100%;
        padding: 10px 18px 24px;
    }

    /* Header */
    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f0f0f0;
        margin-bottom: 12px;
    }

    .title {
        font-size: 34px;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.015em;
        margin: 0;
        color: var(--text);
    }

    .subtitle {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
    }

    /* Add button (black + label, hover invert) */
    .add-btn {
        height: 44px;
        padding: 0 16px;
        border: 2px solid #000 !important;
        background: #000 !important;
        color: #fff !important;
        border-radius: 999px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none !important;
        transition: background-color 220ms ease, color 220ms ease, opacity 220ms ease;
        user-select: none;
        white-space: nowrap;
        cursor: pointer;
        font-weight: 800;
        font-size: 14px;
    }

        .add-btn:hover, .add-btn:focus-visible {
            background: #fff !important;
            color: #000 !important;
            outline: none;
        }

        .add-btn:disabled,
        .add-btn[disabled] {
            opacity: .45;
            cursor: not-allowed;
            pointer-events: none;
        }

        .add-btn i {
            font-size: 16px;
            line-height: 1;
        }

    /* Filters */
    .filters {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr auto;
        gap: 10px 12px;
        align-items: end;
        padding: 18px 0 18px;
        border-bottom: 1.5px solid #e5e7eb;
        margin-bottom: 18px;
    }

    .label {
        font-weight: 600;
        color: #111;
        margin-bottom: 6px;
        font-size: 13px;
    }

    .control {
        width: 100%;
        border: 2px solid var(--border) !important;
        border-radius: 16px !important;
        padding: 11px 14px !important;
        height: 46px;
        font-size: 15px !important;
        background: #fff !important;
        color: var(--text) !important;
        outline: none !important;
        box-shadow: none !important;
    }

        .control:focus {
            border-color: #000 !important;
        }

    .filter-actions {
        display: inline-flex;
        gap: 10px;
        align-items: center;
        justify-content: flex-end;
        align-self: flex-end;
        margin-bottom: 2px;
    }

    .pill-btn {
        border-radius: 999px !important;
        padding: 8px 14px !important;
        font-size: 14px !important;
        font-weight: 700 !important;
        border: 2px solid #000 !important;
        background: transparent !important;
        color: #000 !important;
        white-space: nowrap;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color 220ms ease, color 220ms ease;
    }

    .pill-solid {
        background: #000 !important;
        color: #fff !important;
    }

        .pill-solid:hover, .pill-solid:focus-visible {
            background: #fff !important;
            color: #000 !important;
            outline: none;
        }

    .pill-outline:hover, .pill-outline:focus-visible {
        background: #000 !important;
        color: #fff !important;
        outline: none;
    }

    /* ===== Custom Select (cs2) ===== */
    .real-select {
        position: absolute !important;
        opacity: 0 !important;
        pointer-events: none !important;
        width: 1px !important;
        height: 1px !important;
    }

    .cs2 {
        position: relative;
    }

    .cs2-btn {
        width: 100%;
        border: 2px solid var(--border);
        border-radius: 16px;
        padding: 11px 40px 11px 14px;
        height: 46px;
        background: #fff;
        color: #111;
        font-size: 15px;
        font-weight: 500;
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
    }

    .cs2-value {
        flex: 1;
        text-align: left;
    }

    .cs2-btn:focus,
    .cs2.open .cs2-btn {
        border-color: #000 !important;
        outline: none;
    }

    .cs2-caret {
        position: absolute;
        right: 14px;
        top: 50%;
        width: 8px;
        height: 8px;
        border-right: 2px solid #111;
        border-bottom: 2px solid #111;
        transform: translateY(-50%) rotate(45deg);
        pointer-events: none;
    }

    .cs2-menu {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 8px);
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 6px;
        z-index: 9999;
        display: none;
    }

    .cs2.open .cs2-menu {
        display: block;
    }

    .cs2-item {
        width: 100%;
        text-align: left;
        border: 0;
        background: transparent;
        color: #111;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        margin: 2px 0;
        font-weight: 500;
        font-size: 14px;
    }

        .cs2-item:hover {
            background: #f2f2f2;
        }

    /* Table shell */
    .table-shell {
        border: 2px solid #e5e7eb;
        border-radius: var(--radius);
        overflow: hidden;
        background: #fff;
    }

    table.sys-table {
        width: 100%;
        border-collapse: collapse;
    }

    /* === MONOCHROME TABLE (black/grey/white only) === */
    .sys-table thead th {
        font-size: 13.5px;
        font-weight: 700;
        color: #111;
        padding: 16px 14px;
        background: #f6f7f9;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    .sys-table tbody td {
        font-size: 13.5px;
        font-weight: 400;
        color: #111;
        padding: 16px 14px;
        border-bottom: 1px solid #e5e7eb;
        vertical-align: middle;
        background: #fff;
    }
    /* Global column shift → slightly to the right */
    .sys-table thead th,
    .sys-table tbody td {
        padding-left: 22px; /* ← this moves EVERYTHING right */
        padding-right: 18px;
    }


    .sys-table tbody tr:nth-child(even) td {
        background: #fcfcfd;
    }

    .sys-table tbody tr:hover td {
        background: #f2f4f7;
    }

    .sys-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .chk {
        width: 16px;
        height: 16px;
        accent-color: #111;
    }



    /* Equal left & right table edge spacing */
    .sys-table thead th,
    .sys-table tbody td {
        padding-left: 18px;
        padding-right: 18px;
    }



    /* Status pill (allowed colors) */
    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 92px;
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: 700;
        border: 1.5px solid #111;
        background: #fff;
        color: #111;
        font-size: 13px;
        white-space: nowrap;
    }

        .status-pill.low {
            border-color: #f59e0b;
            color: #a16207;
        }

        .status-pill.out {
            border-color: #ef4444;
            color: #b91c1c;
        }

        .status-pill.in {
            border-color: #111;
            color: #111;
        }

    /* Inactive row */
    .inactive-row {
        opacity: 0.55;
    }
    /* Inactive label under item */
    .inactive-badge {
        margin-top: 6px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #f3f4f6;
        color: #6b7280;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .02em;
    }

    /* Action button (monochrome) */
    .action-btn {
        border-radius: 999px !important;
        padding: 8px 24px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        border: 2px solid #111 !important;
        background: #fff !important;
        color: #111 !important;
        white-space: nowrap;
        transition: background-color 180ms ease, color 180ms ease, transform 160ms ease;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 36px;
        max-width: 180px;
        min-width: 180px;
    }

        .action-btn:hover, .action-btn:focus-visible {
            background: #111 !important;
            color: #fff !important;
            outline: none;
            transform: translateY(-1px);
        }

    /* Empty */
    .empty-state {
        text-align: center;
        padding: 48px 0;
        color: var(--muted);
        font-size: 14px;
    }

    @@media (max-width: 980px) {
        .filters {
            grid-template-columns: 1fr 1fr;
        }

        .filter-actions {
            grid-column: 1 / -1;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 600px) {
        .filters {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            width: 100%;
        }

        .pill-btn {
            width: 100%;
        }
    }

    /* Smaller Filter / Reset buttons */
    .filter-actions .pill-btn {
        height: 43px; /* was 46px */
        padding: 6px 12px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        border-width: 2px !important;
    }

    /* optional: slightly tighter spacing */
    .filter-actions {
        gap: 8px; /* was 10px */
    }

    /* Status action pill (Reorder) */
    .status-pill {
        min-width: auto;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 700;
        border-radius: 999px;
        background: #fff;
        border: 1.5px solid #ef4444;
        color: #dc2626;
        transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
    }



        /* keep color logic */
        .status-pill.low {
            border-color: #f59e0b;
            color: #a16207;
        }

            .status-pill.low:hover {
                background: #f59e0b;
                color: #fff;
            }

        .status-pill.out {
            border-color: #ef4444;
            color: #dc2626;
        }



    /* Item column text – NOT bold */
    .sys-table tbody td strong {
        font-weight: 500; /* normal / medium */
        display: block;
        line-height: 1.3;
    }
    /* === Force uniform row height === */
    .sys-table tbody tr {
        height: 76px; /* adjust: 72–80px sweet spot */
    }

    .sys-table tbody td {
        vertical-align: middle;
    }

    /* Item cell layout */
    .item-cell {
        display: flex;
        flex-direction: column;
        justify-content: center; /* keeps it vertically centered in the row */
        gap: 6px;
        min-height: 52px; /* prevents squishy look */
    }

    .item-name {
        font-weight: 500; /* not bold */
        color: #111;
        line-height: 1.25;
        letter-spacing: .1px;
    }



    /* Optional: make inactive rows feel softer but readable */
    .inactive-row .item-name {
        color: #9ca3af;
    }

    /* Item cell: name + badge inline */
    .item-inline {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Item name */
    .item-name {
        font-weight: 500;
        color: #111;
        line-height: 1.2;
    }

    .inactive-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #f5f6f8;
        border: 1px solid #e5e7eb;
        color: #9ca3af;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .02em;
        line-height: 1;
        white-space: nowrap;
    }


    /* Dim inactive row text slightly */
    .inactive-row .item-name {
        color: #9ca3af;
    }
    /* Item text (no bold, still readable) */
    .item-name {
        font-weight: 600; /* or 500 if you want softer */
        color: #111;
    }

    /* Locked pill in Actions */
    .lock-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border-radius: 999px;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        color: #9ca3af;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

        .lock-pill i {
            font-size: 13px;
            opacity: .85;
        }

    .inactive-row td {
        color: #b6bcc6;
    }

    .inactive-row .status-pill {
        opacity: .85;
    }

    .add-btn {
        min-width: 140px; /* 👈 adjust 140–160px to taste */
    }

        .add-btn i {
            width: 16px; /* same icon box */
            text-align: center;
            font-size: 16px;
        }

    /* ===============================
               Subtle vertical column dividers
               (matches monochrome system)
            ================================ */
    .sys-table thead th,
    .sys-table tbody td {
        border-right: 1px solid #eef0f3; /* subtle thin line */
    }

        .sys-table thead th:last-child,
        .sys-table tbody td:last-child {
            border-right: 0;
        }

    /* ===============================
               Pager (monochrome, subtle)
            ================================ */
    .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        border-top: 1px solid #e5e7eb;
        background: #fff;
    }

    .pager-info {
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
    }

    .pager-right {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .pager-label {
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
    }

    .pager-select {
        height: 36px;
        border: 2px solid #e6e7eb;
        border-radius: 12px;
        padding: 0 10px;
        font-size: 13px;
        font-weight: 700;
        background: #fff;
        color: #111;
        outline: none;
    }

        .pager-select:focus {
            border-color: #000;
        }

    .pager-btn {
        height: 36px;
        padding: 0 12px;
        border-radius: 999px;
        border: 2px solid #111;
        background: #fff;
        color: #111;
        font-size: 13px;
        font-weight: 800;
        transition: background-color 160ms ease, color 160ms ease, opacity 160ms ease;
    }

        .pager-btn:hover,
        .pager-btn:focus-visible {
            background: #111;
            color: #fff;
            outline: none;
        }

        .pager-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    .pager-page {
        font-size: 13px;
        font-weight: 800;
        color: #111;
        min-width: 64px;
        text-align: center;
    }

    /* ===== table footer like Supplier ===== */
    .table-footer {
        border-top: 1px solid #e5e7eb;
        padding: 12px 14px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    /* ===== pager layout ===== */
    .pager-left {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .pager-right {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .pager-range {
        display: inline-flex;
        align-items: center;
        height: 38px;
        padding: 0 14px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: #fff;
        color: #111;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

    .pager-label {
        font-size: 13px;
        font-weight: 800;
        color: var(--muted);
        white-space: nowrap;
    }

    /* pager buttons */
    .pager-btn {
        height: 38px;
        min-width: 58px;
        padding: 0 14px;
        border-radius: 999px;
        border: 2px solid #000;
        background: #fff;
        color: #000;
        font-size: 13px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background-color .18s ease, color .18s ease, opacity .18s ease;
    }

        .pager-btn:hover,
        .pager-btn:focus-visible {
            background: #000;
            color: #fff;
            outline: none;
        }

        .pager-btn.is-active {
            min-width: 38px;
            padding: 0 14px;
            background: #000;
            color: #fff;
        }

        .pager-btn[disabled] {
            opacity: .35;
            cursor: not-allowed;
            pointer-events: none;
        }

    .pager-dots {
        font-weight: 900;
        color: #6b7280;
        padding: 0 4px;
    }

    /* compact cs2 for footer */
    .pager-cs2 .cs2-btn {
        height: 38px;
        min-width: 80px;
        border-radius: 999px;
        border: 2px solid #000;
        font-size: 13px;
        font-weight: 900;
        padding: 0 44px 0 14px;
    }

    .pager-cs2 .cs2-menu {
        z-index: 999999 !important;
        box-shadow: 0 16px 45px rgba(0,0,0,.14);
    }

    .pager-cs2 .cs2-item {
        text-align: center;
        font-size: 13px;
        font-weight: 800;
    }

    /* mobile */
    @@media (max-width: 700px) {
        .table-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .pager-right {
            width: 100%;
            justify-content: flex-start;
        }
    }

    /* ===============================
               Subtle vertical column separators
            ================================ */

    /* Header column separators */
    .sys-table thead th {
        border-right: 1px solid #eceef2;
    }

        .sys-table thead th:last-child {
            border-right: none;
        }

    /* Body column separators */
    .sys-table tbody td {
        border-right: 1px solid #f0f2f5;
    }

        .sys-table tbody td:last-child {
            border-right: none;
        }

    /* Global column shift → slightly to the right */
    .sys-table thead th,
    .sys-table tbody td {
        padding-left: 22px;
        padding-right: 18px;
    }

    /* Equal left & right table edge spacing */
    .sys-table thead th,
    .sys-table tbody td {
        padding-left: 18px;
        padding-right: 18px;
    }

    .sys-table thead th,
    .sys-table tbody td {
        padding-left: 18px;
        padding-right: 18px;
    }

    .sys-table thead th {
        border-right: 1px solid #eceef2;
    }

        .sys-table thead th:last-child {
            border-right: 0;
        }

    .sys-table tbody td {
        border-right: 1px solid #f0f2f5;
    }

        .sys-table tbody td:last-child {
            border-right: 0;
        }
    /* ✅ allow cs2 to open upward when needed */
    .cs2.open-up .cs2-menu {
        transform-origin: bottom;
    }

    /* ✅ scroll if too tall */
    .cs2-menu {
        overflow: auto;
    }
    /* ===============================
               CS2 dropdown — NO SCROLLER
               (match Maintain Supplier)
            ================================ */

    /* completely remove scrolling */
    .cs2-menu {
        overflow: hidden !important;
        max-height: none !important;
    }

    /* pager dropdown specifically */
    .pager-cs2 .cs2-menu {
        overflow: hidden !important;
        max-height: none !important;
    }
    /* Locked pill in Actions — match Adjust button size */
    .lock-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 36px;
        min-width: 180px;
        max-width: 180px;
        padding: 8px 24px; /* same “feel” as action-btn */
        border-radius: 999px;
        background: #f3f4f6;
        border: 2px solid #e5e7eb; /* optional: keep it consistent thickness */
        color: #9ca3af;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

        .lock-pill i {
            font-size: 13px;
            opacity: .85;
        }
    /* ===============================
           System Alert (Error)
           =============================== */
    .sys-alert {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        margin-bottom: 18px;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.45;
        border: 1.5px solid transparent;
    }

        .sys-alert i {
            font-size: 16px;
            flex-shrink: 0;
        }

        /* Error variant */
        .sys-alert.error {
            background: #fef2f2; /* soft red */
            border-color: #fecaca; /* muted red border */
            color: #7f1d1d; /* dark red text */
        }
    /* Costing method pill (read-only badge, not input look) */
    .cost-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        min-width: 140px;
        padding: 0 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
        background: #fff;
        border: 1.5px solid #e5e7eb;
        color: #111;
    }

        /* variants */
        .cost-pill.fixed {
            border-color: #111;
            color: #111;
        }

        .cost-pill.weighted {
            border-color: #6b7280;
            color: #374151;
        }

        .cost-pill.fifo {
            border-color: #9ca3af;
            color: #6b7280;
        }

        .cost-pill.unknown {
            color: #9ca3af;
        }

</style>

<div class="page-wrap">

    @if (TempData["Error"] != null)
    {
        <div class="sys-alert error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["Error"]</span>
        </div>
    }


    <div class="page-head">
        <div>
            <h1 class="title">Manage Stock</h1>
            <p class="subtitle">Search, filter and manage inventory stock.</p>
        </div>

        <div style="display:flex; gap:10px; align-items:center;">
            <!-- Add Stock -->
            <button id="bulkAddBtn"
                    class="add-btn"
                    type="button"
                    title="Increase stock quantity"
                    disabled>
                <i class="bi bi-plus-lg"></i>
                <span>Stock In</span>
            </button>


            <!-- Stock Out (bulk + single) -->
            <button id="bulkOutBtn"
                    class="add-btn"
                    type="button"
                    title="Reduce stock quantity"
                    disabled>
                <i class="bi bi-dash-lg"></i>
                <span>Stock Out</span>
            </button>
        </div>


    </div>

    <!-- FILTERS (SupplierIndex-style) -->
    <div class="filters">

        <div>
            <div class="label">Search</div>
            <input id="searchBox" type="text" class="control" placeholder="Item name / category" />
        </div>

        <div>
            <div class="label">Status</div>

            <!-- real select -->
            <select class="real-select" id="statusFilter">
                <option value="">All</option>
                <option value="In Stock">In Stock</option>
                <option value="Low Stock">Low Stock</option>
                <option value="Out of Stock">Out of Stock</option>
            </select>

            <!-- cs2 -->
            <div class="cs2" data-select="statusFilter">
                <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                    <span class="cs2-value">All</span>
                    <span class="cs2-caret"></span>
                </button>

                <div class="cs2-menu" role="listbox">
                    <button type="button" class="cs2-item" data-value="">All</button>
                    <button type="button" class="cs2-item" data-value="In Stock">In Stock</button>
                    <button type="button" class="cs2-item" data-value="Low Stock">Low Stock</button>
                    <button type="button" class="cs2-item" data-value="Out of Stock">Out of Stock</button>
                </div>
            </div>
        </div>

        <div>
            <div class="label">Sort</div>

            <!-- real select -->
            <select class="real-select" id="sortBy">
                <option value="nameAsc">Name (A–Z)</option>
                <option value="nameDesc">Name (Z–A)</option>
                <option value="qtyAsc">Quantity (Low–High)</option>
                <option value="qtyDesc">Quantity (High–Low)</option>
            </select>

            <!-- cs2 -->
            <div class="cs2" data-select="sortBy">
                <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                    <span class="cs2-value">Name (A–Z)</span>
                    <span class="cs2-caret"></span>
                </button>

                <div class="cs2-menu" role="listbox">
                    <button type="button" class="cs2-item" data-value="nameAsc">Name (A–Z)</button>
                    <button type="button" class="cs2-item" data-value="nameDesc">Name (Z–A)</button>
                    <button type="button" class="cs2-item" data-value="qtyAsc">Quantity (Low–High)</button>
                    <button type="button" class="cs2-item" data-value="qtyDesc">Quantity (High–Low)</button>
                </div>
            </div>
        </div>

        <div class="filter-actions">
            <button id="applyFilter" class="pill-btn pill-solid" type="button">Filter</button>
            <button id="resetFilter" class="pill-btn pill-outline" type="button">Reset</button>
        </div>
    </div>

    <!-- TABLE (SupplierIndex-style) -->
    <div class="table-shell">
        <div class="table-responsive">
            <table class="sys-table" id="stockTable">
                <thead>
                    <tr>
                        <th style="width:70px">
                            <input type="checkbox" id="selectAll" class="chk" />
                        </th>
                        <th style="min-width:160px">Item Name</th>
                        <th style="min-width:160px">Category</th>
                        <th style="width:100px">Available</th>
                        <th style="width:180px">Costing Method</th>
                        <th style="width:160px">Status</th>
                        <th style="width:120px">Updated</th>
                        <th style="width:200px">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">No stock items found.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in Model)
                        {
                            bool isInactive = s.ItemStatus == "Inactive";
                            string statusClass =
                            s.StockStatus == "In Stock" ? "in" :
                            s.StockStatus == "Low Stock" ? "low" : "out";

                            <tr class="@(isInactive ? "inactive-row" : "")"
                                data-status="@s.StockStatus"
                                data-name="@s.ItemName"
                                data-category="@s.CategoryName"
                                data-qty="@s.AvailableQuantity"
                                data-costing="@s.CostingMethod">


                                <td>
                                    <input type="checkbox"
                                           class="row-check chk"
                                           autocomplete="off"
                                           value="@s.InventoryID"
                                           @(isInactive ? "disabled" : "") />

                                </td>
                                <td>
                                    <span class="item-name">@s.ItemName</span>
                                </td>




                                <td>@s.CategoryName</td>

                                <td><strong>@s.AvailableQuantity</strong></td>

                                <td>
                                    @{
                                        var cm = (s.CostingMethod ?? "").Trim();
                                        var display = string.IsNullOrWhiteSpace(cm) ? "—" : cm;

                                        var costClass =
                                        cm.Equals("Fixed", StringComparison.OrdinalIgnoreCase) ? "fixed" :
                                        (cm.Equals("Weighted Average", StringComparison.OrdinalIgnoreCase) || cm.Equals("WeightedAverage", StringComparison.OrdinalIgnoreCase)) ? "weighted" :
                                        cm.Equals("FIFO", StringComparison.OrdinalIgnoreCase) ? "fifo" :
                                        "unknown";
                                    }

                                    <span class="cost-pill @costClass">@display</span>
                                </td>



                                <td>
                                    <span class="status-pill @statusClass">@s.StockStatus</span>
                                </td>

                                <td>@s.LastUpdated.ToString("dd/MM/yyyy")</td>

                                <td>
                                    @if (isInactive)
                                    {
                                        <span class="lock-pill" title="This item is inactive and cannot be adjusted">
                                            <i class="bi bi-lock-fill"></i>
                                            Locked
                                        </span>
                                    }
                                    else
                                    {
                                        <a asp-action="AdjustStockByBatch"
                                           asp-route-inventoryId="@s.InventoryID"
                                           class="action-btn">
                                            Adjust
                                        </a>
                                    }

                                </td>

                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
        <!-- ✅ Table footer pagination (Supplier style) -->
        <div class="table-footer" id="pagerBar">
            <div class="pager-left">
                <span class="pager-range" id="pagerInfo">Showing 0–0 of 0</span>

                <span class="pager-label">Rows per page</span>

                <!-- real select (hidden) -->
                <select class="real-select" id="pageSize">

                    <option value="25">25</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                </select>

                <!-- custom select (cs2) -->
                <div class="cs2 pager-cs2" data-select="pageSize">
                    <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                        <span class="cs2-value">50</span>
                        <span class="cs2-caret"></span>
                    </button>

                    <div class="cs2-menu" role="listbox">

                        <button type="button" class="cs2-item" data-value="25">25</button>
                        <button type="button" class="cs2-item" data-value="50">50</button>
                        <button type="button" class="cs2-item" data-value="100">100</button>
                        <button type="button" class="cs2-item" data-value="200">200</button>
                    </div>
                </div>
            </div>

            <div class="pager-right" id="pagerBtns"></div>
        </div>

    </div>



</div>

@section Scripts {
    <script>
        (() => {

          /* ===============================
             Custom Select (cs2)
             - updates real select value
             - dispatches change (safe: we only listen on pageSize change)
          ================================ */
        function setupCS2(cs) {
          const selectId = cs.dataset.select;
          const real = document.getElementById(selectId);
          if (!real) return;

          const btn = cs.querySelector(".cs2-btn");
          const valueEl = cs.querySelector(".cs2-value");
          const items = Array.from(cs.querySelectorAll(".cs2-item"));
          const menu = cs.querySelector(".cs2-menu");
          if (!btn || !menu) return;

          // remember original menu home
          const originalParent = menu.parentElement;
          const originalNext = menu.nextSibling;

          const setActive = (val) => {
            const found = items.find(i => String(i.dataset.value) === String(val));
            if (valueEl) valueEl.textContent = found ? found.textContent : (items[0]?.textContent || "");
          };

          const measureHeight = () => {
            const prevDisplay = menu.style.display;
            const prevVis = menu.style.visibility;
            menu.style.display = "block";
            menu.style.visibility = "hidden";
            const h = menu.scrollHeight || 240;
            menu.style.visibility = prevVis;
            menu.style.display = prevDisplay;
            return h;
          };

          const placeMenuOnBody = () => {
            document.body.appendChild(menu);
            menu.style.position = "fixed";
            menu.style.zIndex = "2147483647";
          };

          const returnMenuHome = () => {
            if (!originalParent) return;
            if (originalNext) originalParent.insertBefore(menu, originalNext);
            else originalParent.appendChild(menu);
          };

          const positionMenu = () => {
            const rect = btn.getBoundingClientRect();
            const menuH = measureHeight();

            const spaceBelow = window.innerHeight - rect.bottom;
            const spaceAbove = rect.top;
        const desired = menuH; // no artificial height limit


            // ✅ for footer pager dropdown: always prefer open UP
            const forceUp = cs.classList.contains("pager-cs2");
            const openUp = forceUp || (spaceBelow < Math.min(220, desired) && spaceAbove > spaceBelow);
            cs.classList.toggle("open-up", openUp);

            menu.style.left = rect.left + "px";
            menu.style.width = rect.width + "px";
            menu.style.right = "auto";
            menu.style.top = "auto";
            menu.style.bottom = "auto";
            menu.style.maxHeight = "";

            if (openUp) {
              menu.style.bottom = (window.innerHeight - rect.top + 8) + "px";
            } else {
              menu.style.top = (rect.bottom + 8) + "px";
            }
          };

          const open = () => {
            // close others
            document.querySelectorAll(".cs2.open").forEach(other => {
              if (other !== cs) {
                other.classList.remove("open", "open-up");
                other.querySelector(".cs2-btn")?.setAttribute("aria-expanded", "false");
              }
            });

            cs.classList.add("open");
            btn.setAttribute("aria-expanded", "true");

            placeMenuOnBody();
            menu.style.display = "block";
            positionMenu();
          };

          const close = () => {
            cs.classList.remove("open", "open-up");
            btn.setAttribute("aria-expanded", "false");

            menu.style.display = "none";
            menu.style.position = "";
            menu.style.left = "";
            menu.style.top = "";
            menu.style.bottom = "";
            menu.style.width = "";
            menu.style.maxHeight = "";
            menu.style.right = "";
            menu.style.zIndex = "";

            returnMenuHome();
          };

          // init label
          setActive(real.value);

          btn.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            cs.classList.contains("open") ? close() : open();
          });

          items.forEach(i => {
            i.addEventListener("click", (e) => {
              e.preventDefault();
              e.stopPropagation();

              real.value = i.dataset.value ?? "";
              real.dispatchEvent(new Event("change", { bubbles: true })); // ✅ so pageSize updates
              setActive(real.value);
              close();
            });
          });

          document.addEventListener("click", (e) => {
            if (!e.target.closest(".cs2") && cs.classList.contains("open")) close();
          });

          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && cs.classList.contains("open")) close();
          });

          window.addEventListener("scroll", () => {
            if (cs.classList.contains("open")) positionMenu();
          }, true);

          window.addEventListener("resize", () => {
            if (cs.classList.contains("open")) positionMenu();
          });
        }
                  document.querySelectorAll(".cs2[data-select]").forEach(setupCS2);

          /* ===============================
             Refs
          ================================ */
          const tbody = document.querySelector("#stockTable tbody");
          if (!tbody) return;

          const selectAll = document.getElementById("selectAll");
          const bulkAddBtn = document.getElementById("bulkAddBtn");
          const bulkOutBtn = document.getElementById("bulkOutBtn");

          // ✅ ONLY real data rows (your <tr data-name="...">)
          const allRows = Array.from(tbody.querySelectorAll('tr[data-name]'));

          /* ===============================
             Pager refs + state (Supplier style)
          ================================ */
          const pagerBar = document.getElementById("pagerBar");
          const pagerInfo = document.getElementById("pagerInfo");
          const pagerBtns = document.getElementById("pagerBtns");
          const pageSizeEl = document.getElementById("pageSize");

          let filteredRows = [...allRows];
          let pageSize = parseInt(pageSizeEl?.value || "50", 10);
          let page = 1;

          function clampPage() {
            const totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));
            page = Math.min(Math.max(page, 1), totalPages);
            return totalPages;
          }

          const makeDots = () => {
            const s = document.createElement("span");
            s.className = "pager-dots";
            s.textContent = "…";
            return s;
          };

          function renderPager(totalPages) {
            if (!pagerBar) return;

            const total = filteredRows.length;

            // ✅ hide pager when empty
            pagerBar.style.display = (total === 0) ? "none" : "flex";
            if (total === 0) return;

            const startIdx = (page - 1) * pageSize;
            const endIdx = Math.min(startIdx + pageSize, total);

            if (pagerInfo) pagerInfo.textContent = `Showing ${startIdx + 1}–${endIdx} of ${total}`;
            if (!pagerBtns) return;

            pagerBtns.innerHTML = "";

            const makeBtn = (label, onClick, opts = {}) => {
              const b = document.createElement("button");
              b.type = "button";
              b.className = "pager-btn" + (opts.active ? " is-active" : "");
              b.textContent = label;
              if (opts.disabled) b.disabled = true;
              b.addEventListener("click", onClick);
              return b;
            };

            pagerBtns.appendChild(makeBtn("Prev", () => { page--; render(); }, { disabled: page === 1 }));

            const windowSize = 5;
            let start = Math.max(1, page - Math.floor(windowSize / 2));
            let end = Math.min(totalPages, start + windowSize - 1);
            start = Math.max(1, end - windowSize + 1);

            if (start > 1) {
              pagerBtns.appendChild(makeBtn("1", () => { page = 1; render(); }, { active: page === 1 }));
              if (start > 2) pagerBtns.appendChild(makeDots());
            }

            for (let p = start; p <= end; p++) {
              pagerBtns.appendChild(makeBtn(String(p), () => { page = p; render(); }, { active: page === p }));
            }

            if (end < totalPages) {
              if (end < totalPages - 1) pagerBtns.appendChild(makeDots());
              pagerBtns.appendChild(makeBtn(String(totalPages), () => { page = totalPages; render(); }, { active: page === totalPages }));
            }

            pagerBtns.appendChild(makeBtn("Next", () => { page++; render(); }, { disabled: page === totalPages }));
          }

          /* ===============================
             Bulk UI (only visible page rows)
          ================================ */
          function getVisibleChecks() {
            return Array.from(tbody.querySelectorAll(".row-check"))
              .filter(c => !c.disabled);
          }

                 function syncBulkUI() {
          const checks = getVisibleChecks();
          const checked = checks.filter(c => c.checked);

          // no selection
          if (checked.length === 0) {
            bulkAddBtn.disabled = true;
            bulkOutBtn.disabled = true;
            if (selectAll) {
              selectAll.checked = false;
              selectAll.indeterminate = false;
            }
            return;
          }

          // get costing methods from selected rows
          const costingSet = new Set(
            checked.map(c => c.closest("tr")?.dataset.costing?.trim())
          );

          const mixedCosting = costingSet.size > 1;

          bulkAddBtn.disabled = mixedCosting;
          bulkOutBtn.disabled = mixedCosting;

          // header checkbox state
          if (selectAll) {
            if (checked.length === checks.length) {
              selectAll.checked = true;
              selectAll.indeterminate = false;
            } else {
              selectAll.checked = false;
              selectAll.indeterminate = true;
            }
          }

          // optional UX hint
          bulkAddBtn.title = mixedCosting
            ? "Selected items must use the same costing method"
            : "Stock In";

          bulkOutBtn.title = mixedCosting
            ? "Selected items must use the same costing method"
            : "Stock Out";
        }


          selectAll?.addEventListener("change", function () {
            getVisibleChecks().forEach(c => c.checked = this.checked);
            syncBulkUI();
          });

          tbody.addEventListener("change", (e) => {
            if (e.target && e.target.classList.contains("row-check")) syncBulkUI();
          });

          window.addEventListener("pageshow", syncBulkUI);

          bulkAddBtn?.addEventListener("click", () => {
            const ids = getVisibleChecks().filter(c => c.checked).map(c => c.value).join(",");
            window.location.href = `/Stock/AddStockBatch?inventoryIds=${ids}`;
          });

          bulkOutBtn?.addEventListener("click", () => {
            const ids = getVisibleChecks().filter(c => c.checked).map(c => c.value).join(",");
            window.location.href = `/Stock/MinusStockBatchBulk?inventoryIds=${ids}`;
          });

          /* ===============================
             Filter + Sort
          ================================ */
          const searchBox = document.getElementById("searchBox");
          const statusFilter = document.getElementById("statusFilter");
          const sortBy = document.getElementById("sortBy");
          const applyBtn = document.getElementById("applyFilter");
          const resetBtn = document.getElementById("resetFilter");

          function applyFilterSort(resetToFirst = true) {
            const keyword = (searchBox?.value || "").trim().toLowerCase();
            const st = statusFilter?.value || "";
            const sort = sortBy?.value || "nameAsc";

            filteredRows = allRows.filter(tr => {
              const name = (tr.dataset.name || "").toLowerCase();
              const cat = (tr.dataset.category || "").toLowerCase();
              const status = tr.dataset.status || "";

              const matchText = !keyword || name.includes(keyword) || cat.includes(keyword);
              const matchStatus = !st || status === st;
              return matchText && matchStatus;
            });

            filteredRows.sort((a, b) => {
              const nameA = (a.dataset.name || "").toLowerCase();
              const nameB = (b.dataset.name || "").toLowerCase();
              const qtyA = parseFloat(a.dataset.qty || "0");
              const qtyB = parseFloat(b.dataset.qty || "0");

              if (sort === "nameAsc") return nameA.localeCompare(nameB);
              if (sort === "nameDesc") return nameB.localeCompare(nameA);
              if (sort === "qtyAsc") return qtyA - qtyB;
              if (sort === "qtyDesc") return qtyB - qtyA;
              return 0;
            });

            if (resetToFirst) page = 1;
            render();
          }

          /* ===============================
             Render (tbody is rebuilt like Supplier)
          ================================ */
          function renderRows(rows) {
            // reset header checkbox each page
            if (selectAll) {
              selectAll.checked = false;
              selectAll.indeterminate = false;
            }

            tbody.innerHTML = "";

            if (rows.length === 0) {
              const tr = document.createElement("tr");
              tr.innerHTML = `<td colspan="7"><div class="empty-state">No stock items found.</div></td>`;
              tbody.appendChild(tr);

              syncBulkUI();
              return;
            }

            rows.forEach(r => tbody.appendChild(r));
            syncBulkUI();
          }

          function render() {
            const totalPages = clampPage();

            if (filteredRows.length === 0) {
              renderRows([]);
              if (pagerBar) pagerBar.style.display = "none";
              if (pagerInfo) pagerInfo.textContent = "Showing 0–0 of 0";
              if (pagerBtns) pagerBtns.innerHTML = "";
              return;
            }

            const startIdx = (page - 1) * pageSize;
            const pageRows = filteredRows.slice(startIdx, startIdx + pageSize);

            renderRows(pageRows);
            renderPager(totalPages);
          }

          /* ===============================
             Events
          ================================ */
          applyBtn?.addEventListener("click", () => applyFilterSort(true));

          searchBox?.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
              e.preventDefault();
              applyFilterSort(true);
            }
          });

          resetBtn?.addEventListener("click", () => {
            if (searchBox) searchBox.value = "";
            if (statusFilter) statusFilter.value = "";
            if (sortBy) sortBy.value = "nameAsc";

            filteredRows = [...allRows];
            page = 1;

            // sync cs2 labels
            document.querySelectorAll(".cs2[data-select]").forEach(cs => {
              const id = cs.dataset.select;
              const real = document.getElementById(id);
              const valueEl = cs.querySelector(".cs2-value");
              const items = Array.from(cs.querySelectorAll(".cs2-item"));
              const found = items.find(i => String(i.dataset.value) === String(real?.value || ""));
              if (valueEl) valueEl.textContent = found ? found.textContent : (items[0]?.textContent || "All");
              cs.classList.remove("open");
              cs.querySelector(".cs2-btn")?.setAttribute("aria-expanded", "false");
            });

            render();
          });

          pageSizeEl?.addEventListener("change", () => {
            pageSize = parseInt(pageSizeEl.value || "50", 10);
            page = 1;
            render();
          });

          /* ===============================
             Initial
          ================================ */
          filteredRows = [...allRows];
          page = 1;
          render();

        })();
    </script>
}





