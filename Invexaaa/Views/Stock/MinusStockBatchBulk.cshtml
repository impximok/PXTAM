@model Invexaaa.Models.ViewModels.BulkMinusStockViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Invexaaa.Models.Invexa.Enums

@{
    ViewData["Title"] = "Stock Out";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    bool isUnitLocked =
        Model.CostingMethod == CostingMethod.Fixed
     || Model.CostingMethod == CostingMethod.WeightedAverage;
}

<style>
    /* ===============================
                   INVEXA · BLACK & WHITE SYSTEM
                =============================== */
    :root {
        --bg: #ffffff;
        --card: #ffffff;
        --text: #111827;
        --muted: #6b7280;
        --border: #e6e7eb;
        --soft: #f3f4f6;
        --shadow: 0 10px 24px rgba(0,0,0,.06);
        --radius: 18px;
        --w-strong: 800;
        --w-mid: 600;
        --w-base: 500;
        --fs-page: 34px;
        --fs-section: 18px;
        --fs-body: 14px;
        --fs-meta: 13px;
        --fs-help: 12px;
        --focus: 0 0 0 4px rgba(17,17,17,.08);
        --danger: #dc2626;
        --ok: #16a34a;
    }

    html, body, main,
    .container-fluid, .content, .content-body,
    .app-content, .app-wrapper {
        background: var(--bg) !important;
    }

    /* Page wrapper */
    .addstock-wrap {
        width: 100%;
        padding: 10px 18px 26px;
        max-width: 1100px;
        margin: 0 auto;
    }

    /* Header */
    .page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 14px;
        padding: 6px 2px 12px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 14px;
    }

    .page-title {
        font-size: var(--fs-page);
        font-weight: var(--w-strong);
        color: var(--text);
        margin: 0;
        line-height: 1.1;
        letter-spacing: .2px;
    }

    .page-subtitle {
        margin: 6px 0 0;
        font-size: var(--fs-meta);
        font-weight: var(--w-base);
        color: var(--muted);
    }

    /* Card */
    .inv-card {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--card);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .inv-card__head {
        padding: 16px 18px;
        border-bottom: 1px solid var(--border);
        background: #fff;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .inv-card__title {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
        color: var(--text);
        letter-spacing: .2px;
        line-height: 1.15;
    }

    .card-subtitle {
        margin: 0;
        font-size: 13px;
        font-weight: 500;
        color: var(--text);
        line-height: 1.55;
    }

    .inv-card__body {
        padding: 16px 18px 18px;
    }

    /* ===== Invexa Section Header (same as Stock In) ===== */
    .inv-head {
        padding: 18px 18px 14px !important;
        background: #fff;
    }

    .inv-head__row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .inv-head__left {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .inv-head__title {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
        color: var(--text);
        line-height: 1.15;
    }

    .inv-head__desc {
        margin: 0;
        font-size: 13px;
        font-weight: 500;
        color: var(--muted);
        line-height: 1.5;
    }

    .inv-head__right {
        display: flex;
        align-items: flex-start;
    }

    .method-pill {
        height: 30px;
        padding: 0 14px;
        border-radius: 999px;
        border: 1.5px solid #111;
        background: #fff;
        font-size: 12px;
        font-weight: 800;
        color: #111;
        letter-spacing: .2px;
        white-space: nowrap;
    }

    @@media (max-width:768px) {
        .inv-head__row {
            flex-direction: column;
            align-items: flex-start;
        }

        .inv-head__right {
            margin-top: 6px;
        }
    }

    /* Form grid (same rhythm as Stock In) */
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 22px;
        row-gap: 22px;
        align-items: start;
    }

    @@media (max-width:768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    .field {
        display: flex;
        flex-direction: column;
    }

    /* Labels (same pattern) */
    .inv-label {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: var(--w-mid);
        color: var(--text);
    }

    .label-main {
        display: inline-flex;
        align-items: baseline;
        gap: 4px;
    }

    .label-meta {
        font-size: var(--fs-help);
        font-weight: var(--w-base);
        color: var(--muted);
        white-space: nowrap;
    }

    .req {
        color: var(--danger);
        font-weight: var(--w-strong);
        font-size: 12px;
        line-height: 1;
    }

    /* Inputs */
    .inv-input {
        border-radius: 14px !important;
        border: 2px solid var(--border) !important;
        background: #fff !important;
        padding: 10px 12px !important;
        font-size: 14px !important;
        color: var(--text) !important;
        box-shadow: none !important;
        transition: border-color 160ms ease, box-shadow 160ms ease;
    }

        .inv-input:focus {
            border: 2px solid #111 !important;
            outline: none !important;
        }

        .inv-input::placeholder {
            color: #9ca3af;
        }

    /* Validation */
    .text-danger,
    .field-validation-error,
    span[data-valmsg-for] {
        display: block;
        margin-top: 6px !important;
        font-size: var(--fs-help);
        font-weight: var(--w-base) !important;
        color: var(--danger) !important;
        line-height: 1.25;
        padding-left: 2px;
    }

    .input-validation-error,
    .inv-input.input-validation-error {
        border: 2px solid var(--danger) !important;
    }

    /* Actions */
    .actions {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
    }

    .pill-btn {
        border-radius: 999px !important;
        padding: 10px 20px !important;
        font-size: 13px !important;
        font-weight: var(--w-strong) !important;
        border: 2px solid #111 !important;
        min-width: 160px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
        text-decoration: none !important;
        white-space: nowrap;
    }

    .pill-btn--primary {
        background: #111 !important;
        color: #fff !important;
    }

        .pill-btn--primary:hover {
            background: #fff !important;
            color: #111 !important;
            box-shadow: 0 4px 14px rgba(0,0,0,.10);
        }

    .pill-btn--ghost {
        background: #fff !important;
        color: #111 !important;
    }

        .pill-btn--ghost:hover {
            background: #111 !important;
            color: #fff !important;
            box-shadow: 0 4px 14px rgba(0,0,0,.10);
        }

    .pill-btn:disabled {
        opacity: .55;
        cursor: not-allowed;
        box-shadow: none !important;
    }

    @@media (max-width:768px) {
        .pill-btn {
            width: 100%;
        }
    }

    /* Preview card */
    .preview-card {
        overflow: hidden;
    }

    .preview-head {
        padding: 16px 18px !important;
        border-bottom: 1px solid var(--border);
        background: #fff !important;
    }

    .preview-title .t {
        font-size: 18px;
        font-weight: var(--w-strong);
        color: var(--text);
        margin: 0;
        line-height: 1.15;
    }

    .preview-title .s {
        font-size: var(--fs-meta);
        font-weight: var(--w-base);
        color: var(--muted);
        margin-top: 4px;
    }

    /* Table */
    .inv-table {
        width: 100%;
        margin: 0;
    }

        .inv-table thead th {
            background: var(--soft) !important;
            color: var(--text) !important;
            font-size: var(--fs-help) !important;
            font-weight: var(--w-strong) !important;
            text-transform: uppercase;
            letter-spacing: .25px;
            border-bottom: 1px solid var(--border) !important;
            padding: 12px 14px !important;
            white-space: nowrap;
        }

        .inv-table tbody td {
            font-size: var(--fs-body);
            font-weight: var(--w-base);
            color: var(--text);
            border-top: 1px solid #eef0f3 !important;
            padding: 16px 14px !important;
            vertical-align: middle;
        }

        .inv-table tbody tr:nth-child(even) {
            background: #fcfcfd;
        }

        .inv-table tbody tr:hover {
            background: #f9fafb;
        }

    .mono-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        min-width: 64px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1.5px solid #d1d5db;
        background: #fff;
        font-size: var(--fs-help);
        font-weight: var(--w-mid);
        color: var(--text);
        white-space: nowrap;
    }

    .mono-pill--muted {
        background: #f3f4f6;
        border-color: #d1d5db;
        color: var(--muted);
        font-weight: var(--w-base);
    }

    .mono-pill--danger {
        background: #fff;
        border-color: var(--danger);
        color: var(--danger);
        font-weight: var(--w-strong);
    }

    /* Success header (same as Stock In) */
    .success-head {
        padding: 16px 18px !important;
        background: #fff !important;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .success-left {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .success-icon {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 14px;
        background: var(--ok);
        color: #fff;
        line-height: 1;
        margin-top: 2px;
    }

    .success-title {
        font-size: 16px;
        font-weight: var(--w-strong);
        color: var(--text);
        line-height: 1.15;
    }

    .success-sub {
        margin-top: 4px;
        font-size: var(--fs-meta);
        font-weight: var(--w-base);
        color: var(--muted);
        line-height: 1.4;
    }

    /* ===== Custom Select (cs2) – same as Stock In ===== */
    .real-select {
        position: absolute !important;
        opacity: 0 !important;
        pointer-events: none !important;
        width: 1px !important;
        height: 1px !important;
    }

    .cs2 {
        position: relative;
    }

    .cs2-btn {
        width: 100%;
        border: 2px solid var(--border);
        border-radius: 14px;
        padding: 8px 40px 8px 12px;
        height: 42px;
        background: #fff;
        color: var(--text);
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
        transition: border-color 160ms ease, box-shadow 160ms ease;
    }

    .cs2-value {
        flex: 1;
        text-align: left;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cs2-btn:focus,
    .cs2.open .cs2-btn {
        border-color: #111 !important;
        outline: none;
    }

    .cs2-caret {
        position: absolute;
        right: 14px;
        top: 50%;
        width: 8px;
        height: 8px;
        border-right: 2px solid #111;
        border-bottom: 2px solid #111;
        transform: translateY(-50%) rotate(45deg);
        pointer-events: none;
    }

    .cs2-menu {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 8px);
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 6px;
        z-index: 9999;
        display: none;
        overflow: hidden;
    }

    .cs2.open .cs2-menu {
        display: block;
    }

    .cs2-item {
        width: 100%;
        text-align: left;
        border: 0;
        background: transparent;
        color: var(--text);
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        margin: 2px 0;
        font-weight: 500;
        font-size: 14px;
    }

        .cs2-item:hover {
            background: #f3f4f6;
        }

    /* error: real select validation -> highlight button */
    .real-select.input-validation-error + .cs2 .cs2-btn {
        border-color: var(--danger) !important;
        box-shadow: none !important;
    }
    /* ===== Locked / disabled unit field ===== */
    .inv-input:disabled,
    .inv-input[disabled] {
        background: #f3f4f6 !important; /* soft gray */
        color: #6b7280 !important; /* muted text */
        border-color: #e5e7eb !important;
        cursor: not-allowed;
        opacity: 1; /* prevent browser default fade */
    }

        /* Remove focus / hover effects when disabled */
        .inv-input:disabled:focus {
            box-shadow: none !important;
            border-color: #e5e7eb !important;
        }

    /* ===== Custom Select (cs2) ===== */
    .real-select {
        position: absolute !important;
        opacity: 0 !important;
        pointer-events: none !important;
        width: 1px !important;
        height: 1px !important;
    }

    .cs2 {
        position: relative;
    }

    .cs2-btn {
        width: 100%;
        border: 2px solid var(--border);
        border-radius: 14px;
        padding: 8px 40px 8px 12px;
        height: 42px;
        background: #fff;
        color: var(--text);
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
        transition: border-color 160ms ease, box-shadow 160ms ease;
    }

    .cs2-value {
        flex: 1;
        text-align: left;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cs2-btn:focus,
    .cs2.open .cs2-btn {
        border-color: #111 !important;
        outline: none;
    }

    .cs2-caret {
        position: absolute;
        right: 14px;
        top: 50%;
        width: 8px;
        height: 8px;
        border-right: 2px solid #111;
