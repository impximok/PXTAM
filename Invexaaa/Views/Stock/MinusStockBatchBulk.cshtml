</style>

<div class="addstock-wrap">

    <!-- Header -->
    <div class="page-head">
        <div>
            <h1 class="page-title">Stock Out</h1>
            <p class="page-subtitle">Deduct quantity from selected items. Preview updates live.</p>
        </div>
    </div>

    <form asp-action="MinusStockBatchBulk" method="post" novalidate>

        <input type="hidden" asp-for="CostingMethod" />

        @Html.AntiForgeryToken()

        @foreach (var id in Model.InventoryIds)
        {
            <input type="hidden" name="InventoryIds" value="@id" />
        }

        <!-- FORM CARD -->
        <div class="inv-card">

            <!-- ✅ Same header component as Stock In -->
            <div class="inv-card__head inv-head">
                <div class="inv-head__row">
                    <div class="inv-head__left">
                        <h2 class="inv-head__title">Stock Deduction</h2>

                        <p class="inv-head__desc">
                            @if (Model.CostingMethod == CostingMethod.FIFO)
                            {
                                <span><b>FIFO</b> costing is applied automatically. Stock is deducted from <b>oldest batches</b> first.</span>
                            }
                            else if (Model.CostingMethod == CostingMethod.WeightedAverage)
                            {
                                <span><b>Weighted Average</b> costing is applied automatically. Unit cost follows the <b>current average</b>.</span>
                            }
                            else if (Model.CostingMethod == CostingMethod.Fixed)
                            {
                                <span><b>Fixed</b> costing is applied automatically. Unit cost uses <b>standard cost</b>.</span>
                            }
                        </p>
                    </div>

                    <div class="inv-head__right">
                        @{
                            string methodText =
                            Model.CostingMethod == CostingMethod.WeightedAverage ? "Weighted Average" :
                            Model.CostingMethod == CostingMethod.Fixed ? "Fixed" :
                            "FIFO";
                        }

                        <span class="method-pill" title="@methodText">@methodText</span>
                    </div>

                </div>
            </div>
            @if (!Model.HasAnyStock)
            {
                <div class="inline-warn" style="margin-bottom:16px;">
                    <div class="icon">!</div>
                    <div class="msg">
                        No stock is available for deduction.<br />
                        Please stock in this item before performing stock out.
                    </div>
                </div>
            }



            <div class="inv-card__body">
                <div class="form-grid">

                    <!-- Quantity -->
                    <div class="field">
                        <div class="inv-label">
                            <span class="label-main">Quantity to Deduct <span class="req">*</span></span>
                        </div>
                        <input asp-for="InputQuantity"
                               type="number"
                               min="1"
                               class="form-control inv-input js-int"
                               id="qtyInput"
                               placeholder="e.g. 3" />

                        <span asp-validation-for="InputQuantity" class="text-danger"></span>
                    </div>

                    <!-- Unit -->
                    <div class="field">
                        <div class="inv-label">
                            <span class="label-main">Unit <span class="req">*</span></span>
                            <span class="label-meta">@((isUnitLocked) ? "Locked by costing" : "")</span>
                        </div>

                        <!-- real select (binds to model) -->
                        <select asp-for="UnitConversionID"
                                class="real-select You DO NOT disable"
                                id="unitSelect">


                            <option value="">-- Select Unit --</option>
                            @foreach (var unit in Model.AvailableUnits)
                            {
                                <option value="@unit.ItemUnitConversionID"
                                        data-multiplier="@unit.BaseUnitMultiplier"
                                        selected="@(isUnitLocked && unit.IsBaseUnit ? "selected" : null)">
                                    @unit.UnitName @(unit.IsBaseUnit ? "(Base)" : "")
                                </option>
                            }
                        </select>

                        <!-- custom UI -->
                        <div class="cs2 @(isUnitLocked ? "is-locked" : "")" data-select="unitSelect">
                            <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                                <span class="cs2-value">-- Select Unit --</span>
                                <span class="cs2-caret"></span>
                            </button>

                            <div class="cs2-menu" role="listbox">
                                <button type="button" class="cs2-item" data-value="">-- Select Unit --</button>
                                @foreach (var unit in Model.AvailableUnits)
                                {
                                    <button type="button"
                                            class="cs2-item"
                                            data-value="@unit.ItemUnitConversionID"
                                            data-multiplier="@unit.BaseUnitMultiplier">
                                        @unit.UnitName @(unit.IsBaseUnit ? "(Base)" : "")
                                    </button>
                                }
                            </div>
                        </div>

                        <span asp-validation-for="UnitConversionID" class="text-danger"></span>
                    </div>


                    <!-- Reason -->
                    <div class="field">
                        <div class="inv-label">
                            <span class="label-main">Reason <span class="req">*</span></span>
                        </div>

                        <input asp-for="StockOutRemark"
                               class="form-control inv-input"
                               placeholder="e.g. Sales, Usage, Spoilage" />

                        <span asp-validation-for="StockOutRemark" class="text-danger"></span>
                    </div>

                    <!-- Customer -->
                    <div class="field">
                        <div class="inv-label">
                            <span class="label-main">Customer</span>
                            <span class="label-meta">Optional</span>
                        </div>

                        <!-- real select (binds to model) -->
                        <select asp-for="CustomerID"
                                class="real-select"
                                id="customerSelect">
                            <option value="">-- Select Customer --</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.CustomerID">@c.CustomerName</option>
                            }
                        </select>

                        <!-- custom UI -->
                        <div class="cs2" data-select="customerSelect">
                            <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                                <span class="cs2-value">-- Select Customer --</span>
                                <span class="cs2-caret"></span>
                            </button>

                            <div class="cs2-menu" role="listbox">
                                <button type="button" class="cs2-item" data-value="">-- Select Customer --</button>
                                @foreach (var c in Model.Customers)
                                {
                                    <button type="button" class="cs2-item" data-value="@c.CustomerID">@c.CustomerName</button>
                                }
                            </div>
                        </div>

                        <span asp-validation-for="CustomerID" class="text-danger"></span>
                    </div>


                    <!-- Customer snapshot -->
                    <div class="field">
                        <div class="inv-label">
                            <span class="label-main">Customer Name (fallback)</span>
                            <span class="label-meta">Used when no customer</span>
                        </div>

                        <input asp-for="CustomerNameSnapshot"
                               class="form-control inv-input"
                               id="customerSnapshot"
                               placeholder="e.g. Walk-in customer, Order #1234" />

                        <span asp-validation-for="CustomerNameSnapshot" class="text-danger"></span>
                    </div>

                </div>

                <div class="actions">
                    <button type="submit" class="pill-btn pill-btn--primary">
                        Confirm
                    </button>

                    <a asp-action="StockIndex" class="pill-btn pill-btn--ghost">
                        Cancel
                    </a>
                </div>
            </div>
        </div>

        @if (!Model.ShowSummary)
        {
            <!-- Preview -->
            <div class="inv-card mt-4 preview-card">
                <div class="preview-head">
                    <div class="preview-title">
                        <div class="t">Stock Preview</div>
                        <div class="s">Check stock levels before confirming deduction.</div>
                    </div>
                </div>

                <div class="inv-card__body" style="padding:0;">
                    <table class="table inv-table mb-0">
                        <thead>
                            <tr>
                                <th style="width:55%">Item</th>
                                <th style="width:20%">Current</th>
                                <th style="width:25%">After Deduction</th>
                            </tr>
                        </thead>
                        <tbody id="previewBody">
                            @foreach (var p in Model.PreviewItems)
                            {
                                <tr data-available="@p.AvailableQuantity">
                                    <td>@p.ItemName</td>
                                    <td><span class="mono-pill">@p.AvailableQuantity</span></td>
                                    <td class="afterQty"><span class="mono-pill mono-pill--muted">–</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <!-- Success -->
            <div class="inv-card mt-4">
                <div class="success-head">
                    <div class="success-left">
                        <span class="success-icon">✓</span>
                        <div>
                            <div class="success-title">Stock Out Successful</div>
                            <div class="success-sub">
                                @{
                                    var names = (Model.PreviewItems ?? new()).Select(x => x.ItemName).ToList();
                                    var count = names.Count;

                                    if (count == 1)
                                    {
                                        <text>
                                            Deducted <b>@Model.InputQuantity</b> unit(s) from <b>@names[0]</b> with reason <b>@Model.StockOutRemark</b>.
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            Deducted <b>@Model.InputQuantity</b> unit(s) from <b>@count</b> item(s) with reason <b>@Model.StockOutRemark</b>.
                                        </text>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <a asp-action="StockIndex" class="pill-btn pill-btn--ghost">Back to Stock</a>
                </div>

            </div>
        }

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const qtyInput = document.getElementById("qtyInput");
        const unitSelect = document.getElementById("unitSelect");
        const confirmBtn = document.querySelector(".pill-btn--primary");

        function getBaseQty() {
            const qty = Number(qtyInput.value);
            const selected = unitSelect.options[unitSelect.selectedIndex];
            const multiplier = Number(selected?.dataset.multiplier);
            if (!qty || !multiplier) return 0;
            return qty * multiplier;
        }

        function updatePreview() {
            const tbody = document.getElementById("previewBody");
            if (!tbody) return;

            const baseQty = getBaseQty();

            document.querySelectorAll("#previewBody tr").forEach(row => {
                const available = parseInt(row.dataset.available, 10);
                const afterCell = row.querySelector(".afterQty");

                if (!baseQty) {
                    afterCell.innerHTML = `<span class="mono-pill mono-pill--muted">–</span>`;
                    return;
                }

                const remaining = available - baseQty;

                if (remaining < 0) {
                    afterCell.innerHTML = `<span class="mono-pill mono-pill--danger">Insufficient</span>`;
                } else {
                    afterCell.innerHTML = `<span class="mono-pill">${remaining} base units</span>`;
                }
            });
        }

        qtyInput.addEventListener("input", () => {
            updatePreview();
            toggleConfirm();
        });

        unitSelect.addEventListener("change", () => {
            updatePreview();
            toggleConfirm();
        });

        // Customer field sync
        const customerSelect = document.getElementById("customerSelect");
        const customerSnapshot = document.getElementById("customerSnapshot");

        function syncCustomerFields() {
            if (customerSelect.value) {
                customerSnapshot.value = "";
                customerSnapshot.disabled = true;
            } else {
                customerSnapshot.disabled = false;
            }
        }

        customerSelect?.addEventListener("change", syncCustomerFields);
        syncCustomerFields();

                // Auto-clear quantity on focus
        qtyInput.addEventListener("focus", () => {
            if (qtyInput.value === "0") {
                qtyInput.value = "";
            }
        });
        function setupCS2(cs) {
            const selectId = cs.dataset.select;
            const real = document.getElementById(selectId);
            if (!real) return;

            const btn = cs.querySelector(".cs2-btn");
            const valueEl = cs.querySelector(".cs2-value");
            const items = Array.from(cs.querySelectorAll(".cs2-item"));

            const isLocked = cs.classList.contains("is-locked") || real.disabled;

            const setActive = (val) => {
                const found = items.find(i => String(i.dataset.value) === String(val));
                valueEl.textContent = found ? found.textContent.trim() : (items[0]?.textContent.trim() || "");
            };

            const open = () => {
                if (isLocked) return;
                document.querySelectorAll(".cs2.open").forEach(o => {
                    if (o !== cs) {
                        o.classList.remove("open");
                        o.querySelector(".cs2-btn")?.setAttribute("aria-expanded", "false");
                    }
                });
                cs.classList.add("open");
                btn.setAttribute("aria-expanded", "true");
            };

            const close = () => {
                cs.classList.remove("open");
                btn.setAttribute("aria-expanded", "false");
            };

            // initial
            setActive(real.value);

            btn.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (isLocked) return;
                cs.classList.contains("open") ? close() : open();
            });

            items.forEach(i => {
                i.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (isLocked) return;

                    real.value = i.dataset.value ?? "";
                    real.dispatchEvent(new Event("change", { bubbles: true }));
                    real.dispatchEvent(new Event("blur", { bubbles: true }));

                    setActive(real.value);
                    close();
                });
            });

            document.addEventListener("click", (e) => {
                if (!e.target.closest(".cs2") && cs.classList.contains("open")) close();
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && cs.classList.contains("open")) close();
            });

            // keep UI synced if value changes from code
            real.addEventListener("change", () => setActive(real.value));
        }

        // init all cs2
        document.querySelectorAll(".cs2[data-select]").forEach(setupCS2);

                function getBaseQty() {
            const qty = Number(qtyInput.value);
            const selected = unitSelect.options[unitSelect.selectedIndex];
            const multiplier = Number(selected?.dataset.multiplier || 1);

            if (!qty) return 0;
            return qty * multiplier;
        }
                function setupIntInput(el) {
            if (!el) return;

            // Clear when focused and value is 0
            el.addEventListener("focus", () => {
                if (el.value === "0") el.value = "";
            });

            // Block invalid keys (letters, e/E, +, -, .)
            el.addEventListener("keydown", (e) => {
                const blocked = ["e", "E", "+", "-", ".", ","];
                if (blocked.includes(e.key)) {
                    e.preventDefault();
                }
            });

            // Sanitize pasted input (digits only)
            el.addEventListener("input", () => {
                el.value = el.value.replace(/[^\d]/g, "");
            });

            // Prevent mouse wheel from changing value
            el.addEventListener("wheel", () => el.blur());
        }

    </script>
}
