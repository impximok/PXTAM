@model List<Invexaaa.Models.ViewModels.StockTransactionHistoryViewModel>

@{
    ViewData["Title"] = "Stock Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --bg: #ffffff;
        --card: #ffffff;
        --border: #e6e7eb;
        --text: #111827;
        --muted: #6b7280;
        --soft: #f9fafb;
        --radius: 18px;
        --shadow: 0 10px 30px rgba(0,0,0,.06);
        --black: #111;
        --chip: #f6f7f9;
        --green: #16a34a;
        --greenBg: rgba(22,163,74,.10);
        --red: #dc2626;
        --redBg: rgba(220,38,38,.10);
        --rowH: 56px;
    }

    html, body, main,
    .container-fluid, .content, .content-body,
    .app-content, .app-wrapper {
        background: var(--bg) !important;
    }

    /* Full width padding like your system pages */
    .page-wrap {
        width: 100%;
        padding: 10px 18px 24px;
    }

    /* Header (system style) */
    .page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 2px 14px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 14px;
    }

    .head-left .title {
        font-size: 34px;
        font-weight: 900;
        letter-spacing: .2px;
        margin: 0;
        color: var(--text);
        line-height: 1.15;
    }

    .head-left .subtitle {
        margin: 6px 0 0;
        font-size: 13px;
        color: var(--muted);
    }

    /* Card shell */
    .table-card {
        background: var(--card);
        border: 2px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden; /* ✅ IMPORTANT: makes bottom corners round */
    }

    /* Table */
    table.sys-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed; /* important: consistent layout + truncation */
    }

    .sys-table thead th {
        background: var(--chip);
        padding: 14px 16px;
        font-size: 13px;
        font-weight: 800;
        color: var(--black);
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
        text-transform: none; /* keep as typed */
        letter-spacing: .2px;
    }

        /* subtle vertical separators like enterprise systems */
        .sys-table thead th + th,
        .sys-table tbody td + td {
            border-left: 1px solid rgba(0,0,0,.04);
        }

    .sys-table tbody tr {
        height: var(--rowH);
    }

    .sys-table tbody td {
        padding: 12px 16px;
        font-size: 13.5px;
        color: var(--text);
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
        background: #fff;
    }

    .sys-table tbody tr:nth-child(even) td {
        background: #fcfcfd;
    }

    .sys-table tbody tr:hover td {
        background: #f3f4f6;
    }

    /* Truncation helpers */
    .ellipsis {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Strong item name */
    .item-name {
        font-weight: 900;
        color: var(--text);
    }

    /* Muted text */
    .muted {
        color: var(--muted);
    }

    /* Type pill (more “system” consistent) */
    .type-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 76px;
        height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        font-weight: 900;
        font-size: 12px;
        border: 2px solid var(--black);
        white-space: nowrap;
        line-height: 1;
    }

        .type-pill::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: var(--black);
            opacity: .9;
        }

    .type-in {
        color: var(--green);
        border-color: var(--green);
        background: var(--greenBg);
    }

        .type-in::before {
            background: var(--green);
        }

    .type-out {
        color: var(--red);
        border-color: var(--red);
        background: var(--redBg);
    }

        .type-out::before {
            background: var(--red);
        }

    /* Quantity (monospace feel for audit logs) */
    .qty {
        font-weight: 900;
        font-variant-numeric: tabular-nums;
    }

    /* Empty state */
    .empty-state {
        padding: 44px 18px;
        text-align: center;
        color: var(--muted);
        font-size: 14px;
    }

    /* Column sizing (tweak safely) */
    .col-date {
        width: 160px;
    }

    .col-item {
        width: 220px;
    }

    .col-batch {
        width: 150px;
    }

    .col-type {
        width: 110px;
    }

    .col-qty {
        width: 110px;
    }

    .col-user {
        width: 160px;
    }
    /* Remark stays flexible */
    .col-remark {
        width: auto;
    }

    /* Mobile: keep it readable */
    @@media (max-width: 992px) {
        .col-remark {
            width: 260px;
        }

        .col-item {
            width: 200px;
        }

        .page-head {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    /* ===============================
           Filters (same style as Supplier)
        =============================== */
    .filters {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr auto;
        gap: 10px 12px;
        align-items: end;
        padding: 18px 0 18px;
        border-bottom: 1.5px solid #e5e7eb;
        margin: 10px 0 18px;
    }

    .label {
        font-weight: 600;
        color: #111;
        margin-bottom: 6px;
        font-size: 13px;
    }

    .control {
        width: 100%;
        border: 2px solid var(--border) !important;
        border-radius: 16px !important;
        padding: 11px 14px !important;
        height: 46px;
        font-size: 15px !important;
        background: #fff !important;
        color: var(--text) !important;
        outline: none !important;
        box-shadow: none !important;
    }

        .control:focus {
            border-color: #000 !important;
        }

    .filter-actions {
        display: inline-flex;
        gap: 10px;
        align-items: center;
        justify-content: flex-end;
        align-self: flex-end;
        margin-bottom: 2px;
    }

    .pill-btn {
        border-radius: 999px !important;
        padding: 8px 14px !important;
        font-size: 14px !important;
        font-weight: 700 !important;
        border: 2px solid #000 !important;
        background: transparent !important;
        color: #000 !important;
        white-space: nowrap;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color 220ms ease, color 220ms ease;
    }

    .pill-solid {
        background: #000 !important;
        color: #fff !important;
    }

        .pill-solid:hover, .pill-solid:focus-visible {
            background: #fff !important;
            color: #000 !important;
            outline: none;
        }

    .pill-outline:hover, .pill-outline:focus-visible {
        background: #000 !important;
        color: #fff !important;
        outline: none;
    }

    /* ===== Custom Select (cs2) ===== */
    .real-select {
        position: absolute !important;
        opacity: 0 !important;
        pointer-events: none !important;
        width: 1px !important;
        height: 1px !important;
    }

    .cs2 {
        position: relative;
    }

    .cs2-btn {
        width: 100%;
        border: 2px solid var(--border);
        border-radius: 16px;
        padding: 11px 40px 11px 14px;
        height: 46px;
        background: #fff;
        color: #111;
        font-size: 15px;
        font-weight: 500;
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
    }

    .cs2-value {
        flex: 1;
        text-align: left;
    }

    .cs2-btn:focus,
    .cs2.open .cs2-btn {
        border-color: #000 !important;
        outline: none;
    }

    .cs2-caret {
        position: absolute;
        right: 14px;
        top: 50%;
        width: 8px;
        height: 8px;
        border-right: 2px solid #111;
        border-bottom: 2px solid #111;
        transform: translateY(-50%) rotate(45deg);
        pointer-events: none;
    }

    .cs2-menu {
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 8px);
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 6px;
        z-index: 9999;
        display: none;
    }

    .cs2.open .cs2-menu {
        display: block;
    }

    .cs2-item {
        width: 100%;
        text-align: left;
        border: 0;
        background: transparent;
        color: #111;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        margin: 2px 0;
        font-weight: 500;
        font-size: 14px;
    }

        .cs2-item:hover {
            background: #f2f2f2;
        }

    @@media (max-width: 980px) {
        .filters {
            grid-template-columns: 1fr 1fr;
        }

        .filter-actions {
            grid-column: 1 / -1;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 600px) {
        .filters {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            width: 100%;
        }

        .pill-btn {
            width: 100%;
        }
    }

    .sys-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .table-responsive {
        margin: 0;
    }

    /* clips ONLY the table area so corners stay round */
    .table-clip {
        border-radius: var(--radius);
        overflow: hidden;
    }

    /* ===============================
           Paging bar (INVEXA style)
        =============================== */
    .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-top: 1px solid var(--border);
        background: #fff;
    }

    .pager-left {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
    }

    .pager-right {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .pager-btn {
        height: 38px;
        min-width: 38px;
        padding: 0 12px;
        border-radius: 999px;
        border: 2px solid #000;
        background: #fff;
        color: #000;
        font-size: 13px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease;
    }

        .pager-btn:hover,
        .pager-btn:focus-visible {
            background: #000;
            color: #fff;
            outline: none;
        }

        .pager-btn[disabled] {
            opacity: .35;
            cursor: not-allowed;
        }

        .pager-btn.is-active {
            background: #000;
            color: #fff;
        }

    .pager-select {
        height: 38px;
        border-radius: 999px;
        border: 2px solid var(--border);
        padding: 0 12px;
        font-size: 13px;
        font-weight: 700;
        color: #111;
        background: #fff;
        outline: none;
    }

        .pager-select:focus {
            border-color: #000;
        }


    /* ===== Pager left polish ===== */
    .pager-left {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
    }

    /* "Showing x–y of z" as a soft pill */
    #pagerInfo {
        display: inline-flex;
        align-items: center;
        height: 38px;
        padding: 0 14px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--soft);
        color: #111;
        font-weight: 600;
        fony-size: 12px;
        letter-spacing: .1px;
    }

    /* Rows label */
    .pager-label {
        color: var(--muted);
        font-weight: 700;
        margin-left: 4px;
    }

    /* Dropdown pill style */
    .pager-select {
        height: 38px;
        border-radius: 999px;
        border: 2px solid #000;
        padding: 0 40px 0 14px; /* room for arrow */
        font-size: 13px;
        font-weight: 800;
        color: #111;
        background: #fff;
        outline: none;
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        cursor: pointer;
        line-height: 38px;
    }

    /* custom arrow */
    .pager-select-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

        .pager-select-wrap::after {
            content: "";
            position: absolute;
            right: 14px;
            width: 8px;
            height: 8px;
            border-right: 2px solid #111;
            border-bottom: 2px solid #111;
            transform: rotate(45deg);
            pointer-events: none;
            opacity: .9;
        }

    /* Pager label tighter + business tone */
    .pager-label {
        color: var(--muted);
        font-weight: 800;
        font-size: 12.5px;
        letter-spacing: .2px;
    }
    /* ===== Pager cs2 dropdown (clean + business) ===== */
    .pager-cs2 {
        position: relative;
    }

        /* Button */
        .pager-cs2 .cs2-btn {
            height: 38px;
            min-width: 80px;
            border-radius: 999px;
            border: 2px solid #000;
            background: #fff;
            color: #111;
            font-size: 13px;
            font-weight: 900;
            padding: 0 40px 0 14px;
            display: flex;
            align-items: center;
            cursor: pointer;
        }

        /* caret stays aligned */
        .pager-cs2 .cs2-caret {
            right: 14px;
        }

        /* Menu: match width + tighter spacing */
        .pager-cs2 .cs2-menu {
            position: absolute;
            left: 0;
            right: 0; /* ✅ match button width */
            top: calc(100% + 8px);
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 6px;
            box-shadow: 0 16px 45px rgba(0,0,0,.14);
            z-index: 99999;
            display: none;
        }

        /* When open */
        .pager-cs2.open .cs2-menu {
            display: block;
        }

        /* Items: tighter, system-like */
        .pager-cs2 .cs2-item {
            width: 100%;
            text-align: left;
            border: 0;
            background: transparent;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 800;
            color: #111;
            cursor: pointer;
        }

            /* Hover */
            .pager-cs2 .cs2-item:hover {
                background: #f3f4f6;
            }



        /* ✅ Remove the weird "speech bubble notch" */
        .pager-cs2 .cs2-menu::before {
            content: none !important;
        }


        /* Cleaner hover + selected style */
        .pager-cs2 .cs2-item {
            border-radius: 10px;
            font-weight: 700;
        }

            .pager-cs2 .cs2-item:hover {
                background: #f3f4f6;
            }

        /* Optional: make the menu feel more "system" */
        .pager-cs2 .cs2-menu::before {
            content: "";
            position: absolute;
            top: -6px;
            right: 18px;
            width: 10px;
            height: 10px;
            background: #fff;
            border-left: 1px solid var(--border);
            border-top: 1px solid var(--border);
            transform: rotate(45deg);
        }


    /* keep table scroll working, but don't clip dropdowns */
    .table-responsive {
        overflow-x: auto;
        overflow-y: visible !important;
    }


    .table-card .sys-table {
        border-radius: var(--radius);
        overflow: hidden;
    }

    .cs2-menu {
        z-index: 99999 !important;
        position: absolute;
    }

    .cs2-menu {
        top: calc(100% + 8px);
    }



    .table-responsive {
        overflow-x: auto;
        overflow-y: visible !important;
    }

    .cs2-menu {
        z-index: 99999 !important;
    }

    .pager-cs2 .cs2-menu {
        transform-origin: top;
    }

    .pager-left {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap; /* if small screen */
    }

    /* Showing pill already OK, but align height with dropdown */
    #pagerInfo {
        height: 38px;
        display: inline-flex;
        align-items: center;
    }

    /* label style */
    .pager-label {
        color: var(--muted);
        font-weight: 800;
        font-size: 12.5px;
        letter-spacing: .2px;
        margin-left: 6px;
        white-space: nowrap;
    }

    .pager-left {
        display: inline-flex;
        align-items: center;
        gap: 14px;
    }

    /* Showing pill = primary info */
    .pager-info {
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid var(--border);
        font-size: 12px;
        font-weight: 600;
        color: #333;
        background: #fff;
    }

    /* Label = secondary helper text */
    .pager-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: .25px;
        white-space: nowrap;
        margin-left: 4px;
    }

    .sys-table tbody tr:hover td {
        background: #f3f4f6;
    }

    .table-clip {
        border-bottom-left-radius: var(--radius);
        border-bottom-right-radius: var(--radius);
        border-top-left-radius: 0;
        border-top-right-radius: 0;
        overflow: hidden;
    }

    .pager-dots {
        color: var(--muted);
        font-weight: 800;
        padding: 0 6px;
    }

    .hint-pill {
        display: inline-flex;
        align-items: center;
        height: 38px;
        padding: 0 14px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: #fff;
        color: var(--muted);
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

</style>

<div class="page-wrap">

    <!-- HEADER -->
    <div class="page-head">
        <div class="head-left">
            <h1 class="title">Stock In / Out History</h1>
            <p class="subtitle">Complete audit trail of inventory movements.</p>
        </div>
        <span class="hint-pill">Audit Trail · Read Only</span>
    </div>

    <div class="filters">

        <div>
            <div class="label">Search</div>
            <input id="qTx" type="text" class="control"
                   placeholder="Item / batch / remark / user" />
        </div>

        <div>
            <div class="label">Type</div>

            <!-- real select -->
            <select class="real-select" id="TxType" name="type">
                <option value="">All</option>
                <option value="IN">In</option>
                <option value="OUT">Out</option>
            </select>

            <!-- custom select -->
            <div class="cs2" data-select="TxType">
                <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                    <span class="cs2-value">All</span>
                    <span class="cs2-caret"></span>
                </button>

                <div class="cs2-menu" role="listbox">
                    <button type="button" class="cs2-item" data-value="">All</button>
                    <button type="button" class="cs2-item" data-value="IN">In</button>
                    <button type="button" class="cs2-item" data-value="OUT">Out</button>
                </div>
            </div>
        </div>

        <div>
            <div class="label">Sort</div>

            <!-- real select -->
            <select class="real-select" id="TxSort" name="sort">
                <option value="new">Newest</option>
                <option value="old">Oldest</option>
                <option value="item_az">Item (A–Z)</option>
                <option value="item_za">Item (Z–A)</option>
                <option value="qty_desc">Quantity (High–Low)</option>
                <option value="qty_asc">Quantity (Low–High)</option>
            </select>

            <!-- custom select -->
            <div class="cs2" data-select="TxSort">
                <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                    <span class="cs2-value">Newest</span>
                    <span class="cs2-caret"></span>
                </button>

                <div class="cs2-menu" role="listbox">
                    <button type="button" class="cs2-item" data-value="new">Newest</button>
                    <button type="button" class="cs2-item" data-value="old">Oldest</button>
                    <button type="button" class="cs2-item" data-value="item_az">Item (A–Z)</button>
                    <button type="button" class="cs2-item" data-value="item_za">Item (Z–A)</button>
                    <button type="button" class="cs2-item" data-value="qty_desc">Quantity (High–Low)</button>
                    <button type="button" class="cs2-item" data-value="qty_asc">Quantity (Low–High)</button>
                </div>
            </div>
        </div>

        <div class="filter-actions">
            <button id="btnTxFilter" class="pill-btn pill-solid" type="button">Filter</button>
            <button id="btnTxReset" class="pill-btn pill-outline" type="button">Reset</button>
        </div>
    </div>

    <!-- TABLE -->
    <div class="table-card">
        <div class="table-clip">
            <div class="table-responsive">
                <table class="sys-table">
                    <thead>
                        <tr>
                            <th class="col-date">Date</th>
                            <th class="col-item">Item</th>
                            <th class="col-batch">Batch</th>
                            <th class="col-type">Type</th>
                            <th class="col-qty">Quantity</th>
                            <th class="col-remark">Remark</th>
                            <th class="col-user">User</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">No stock transactions recorded.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var h in Model)
                            {
                                <tr data-item="@h.ItemName"
                                    data-batch="@h.BatchNumber"
                                    data-type="@h.TransactionType"
                                    data-qty="@h.TransactionQuantity"
                                    data-user="@h.UserName"
                                    data-remark="@h.TransactionRemark"
                                    data-date="@h.TransactionDate.ToString("O")">

                                    <td class="muted ellipsis">@h.TransactionDate.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td class="ellipsis"><span class="item-name">@h.ItemName</span></td>
                                    <td class="muted ellipsis">@h.BatchNumber</td>
                                    <td>
                                        <span class="type-pill @(h.TransactionType == "IN" ? "type-in" : "type-out")">
                                            @h.TransactionType
                                        </span>
                                    </td>
                                    <td class="qty">@h.TransactionQuantity</td>
                                    <td class="muted ellipsis" title="@h.TransactionRemark">@h.TransactionRemark</td>
                                    <td class="muted ellipsis">@h.UserName</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ✅ pager OUTSIDE table-responsive -->
        <div class="pager" id="pagerBar">
            <div class="pager-left">
                <span id="pagerInfo">Showing 0–0 of 0</span>

                <span class="pager-label">Rows per page</span>

                <!-- real select (hidden) -->
                <select class="real-select" id="pageSize">
                    <option value="25">25</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                </select>

                <!-- custom select -->
                <div class="cs2 pager-cs2" data-select="pageSize">
                    <button type="button" class="cs2-btn" aria-haspopup="listbox" aria-expanded="false">
                        <span class="cs2-value">50</span>
                        <span class="cs2-caret"></span>
                    </button>

                    <div class="cs2-menu" role="listbox">
                        <button type="button" class="cs2-item" data-value="25">25</button>
                        <button type="button" class="cs2-item" data-value="50">50</button>
                        <button type="button" class="cs2-item" data-value="100">100</button>
                        <button type="button" class="cs2-item" data-value="200">200</button>
                    </div>
                </div>
            </div>


            <div class="pager-right" id="pagerBtns"></div>
        </div>

    </div>


</div>

<script>
    (() => {

      /* =========================================================
         CS2 (Custom Select) - FIXED dropdown (no clipping) + flip
      ========================================================== */
      function setupCS2(cs) {
        const selectId = cs.dataset.select;
        const real = document.getElementById(selectId);
        if (!real) return;

        const btn = cs.querySelector(".cs2-btn");
        const valueEl = cs.querySelector(".cs2-value");
        const items = Array.from(cs.querySelectorAll(".cs2-item"));
        const menu = cs.querySelector(".cs2-menu");
        if (!btn || !valueEl || !menu || items.length === 0) return;

        const setActive = (val) => {
          items.forEach(x => x.classList.remove("is-selected"));
          const found = items.find(i => String(i.dataset.value) === String(val));
          if (found) found.classList.add("is-selected");
          valueEl.textContent = found ? found.textContent : (items[0]?.textContent || "");
        };

        const cleanupFixedMenu = () => {
          menu.style.position = "";
          menu.style.left = "";
          menu.style.top = "";
          menu.style.bottom = "";
          menu.style.width = "";
          menu.style.maxHeight = "";
          menu.style.right = "";
        };

        const positionFixedMenu = () => {
          const rect = btn.getBoundingClientRect();

          // fixed so it ignores clipping parents (table/card overflow)
          menu.style.position = "fixed";
          menu.style.left = rect.left + "px";
          menu.style.width = rect.width + "px";
          menu.style.right = "auto";

          // reset
          menu.style.top = "auto";
          menu.style.bottom = "auto";
          menu.style.maxHeight = "";

          const spaceBelow = window.innerHeight - rect.bottom;
          const spaceAbove = rect.top;

          // measure menu height
          menu.style.display = "block";
          menu.style.visibility = "hidden";
          const menuH = menu.scrollHeight || 240;
          menu.style.visibility = "";
          menu.style.display = "";

          const desired = Math.min(320, menuH);
          const openUp = spaceBelow < Math.min(220, desired) && spaceAbove > spaceBelow;

          if (openUp) {
            menu.style.bottom = (window.innerHeight - rect.top + 8) + "px";
            menu.style.maxHeight = Math.max(140, Math.min(desired, spaceAbove - 16)) + "px";
          } else {
            menu.style.top = (rect.bottom + 8) + "px";
            menu.style.maxHeight = Math.max(140, Math.min(desired, spaceBelow - 16)) + "px";
          }
        };

        const close = () => {
          cs.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
          cleanupFixedMenu();
        };

        // initial label
        setActive(real.value);

        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();

          const willOpen = !cs.classList.contains("open");

          // close other cs2
          document.querySelectorAll(".cs2.open").forEach(other => {
            if (other !== cs) {
              other.classList.remove("open");
              other.querySelector(".cs2-btn")?.setAttribute("aria-expanded", "false");
              const m = other.querySelector(".cs2-menu");
              if (m) {
                m.style.position = "";
                m.style.left = "";
                m.style.top = "";
                m.style.bottom = "";
                m.style.width = "";
                m.style.maxHeight = "";
                m.style.right = "";
              }
            }
          });

          cs.classList.toggle("open", willOpen);
          btn.setAttribute("aria-expanded", willOpen ? "true" : "false");

          if (willOpen) positionFixedMenu();
          else cleanupFixedMenu();
        });

        items.forEach(i => {
          i.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();

            real.value = i.dataset.value ?? "";
            real.dispatchEvent(new Event("change", { bubbles: true }));
            setActive(real.value);
            close();
          });
        });

        document.addEventListener("click", (e) => {
          if (!cs.contains(e.target)) close();
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && cs.classList.contains("open")) close();
        });

        window.addEventListener("scroll", () => {
          if (cs.classList.contains("open")) positionFixedMenu();
        }, true);

        window.addEventListener("resize", () => {
          if (cs.classList.contains("open")) positionFixedMenu();
        });
      }

      // init all cs2
      document.querySelectorAll(".cs2[data-select]").forEach(setupCS2);

      /* =========================================================
         Helpers
      ========================================================== */
      const makeDots = () => {
        const s = document.createElement("span");
        s.textContent = "…";
        s.className = "pager-dots";
        return s;
      };

      /* =========================================================
         Client-side filtering + paging
      ========================================================== */
      const q = document.getElementById("qTx");
      const typeSelect = document.getElementById("TxType");
      const sortSelect = document.getElementById("TxSort");
      const btnFilter = document.getElementById("btnTxFilter");
      const btnReset  = document.getElementById("btnTxReset");

      const tbody = document.querySelector(".sys-table tbody");
      if (!tbody) return;

      const pagerBar   = document.getElementById("pagerBar");
      const pagerInfo  = document.getElementById("pagerInfo");
      const pagerBtns  = document.getElementById("pagerBtns");
      const pageSizeEl = document.getElementById("pageSize");

      // only actual rows
      const allRows = Array.from(tbody.querySelectorAll("tr[data-item]"));

      let filteredRows = [...allRows];
      let pageSize = parseInt(pageSizeEl?.value || "50", 10);
      let page = 1;

      const EMPTY_HTML = (msg) => `
        <tr>
          <td colspan="7"><div class="empty-state">${msg}</div></td>
        </tr>
      `;

      function clampPage() {
        const totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));
        page = Math.min(Math.max(page, 1), totalPages);
        return totalPages;
      }

      function renderPager(totalPages) {
        if (!pagerBar || !pagerBtns) return;

        const total = filteredRows.length;

        // ✅ IMPORTANT: make sure pager can show
        pagerBar.hidden = (total === 0);
        if (total === 0) return;

        const startIdx = (page - 1) * pageSize;
        const endIdx = Math.min(startIdx + pageSize, total);

        if (pagerInfo) pagerInfo.textContent = `Showing ${startIdx + 1}–${endIdx} of ${total}`;

        pagerBtns.innerHTML = "";

        const makeBtn = (label, onClick, opts = {}) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "pager-btn" + (opts.active ? " is-active" : "");
          b.textContent = label;
          if (opts.disabled) {
            b.disabled = true;
            b.setAttribute("aria-disabled", "true");
          }
          b.addEventListener("click", onClick);
          return b;
        };

        // Prev
        pagerBtns.appendChild(
          makeBtn("Prev", () => { page--; render(); }, { disabled: page === 1 })
        );

        // number window
        const windowSize = 5;
        let start = Math.max(1, page - Math.floor(windowSize / 2));
        let end = Math.min(totalPages, start + windowSize - 1);
        start = Math.max(1, end - windowSize + 1);

        if (start > 1) {
          pagerBtns.appendChild(makeBtn("1", () => { page = 1; render(); }, { active: page === 1 }));
          if (start > 2) pagerBtns.appendChild(makeDots());
        }

        for (let p = start; p <= end; p++) {
          pagerBtns.appendChild(
            makeBtn(String(p), () => { page = p; render(); }, { active: page === p })
          );
        }

        if (end < totalPages) {
          if (end < totalPages - 1) pagerBtns.appendChild(makeDots());
          pagerBtns.appendChild(
            makeBtn(String(totalPages), () => { page = totalPages; render(); }, { active: page === totalPages })
          );
        }

        // Next
        pagerBtns.appendChild(
          makeBtn("Next", () => { page++; render(); }, { disabled: page === totalPages })
        );
      }

      function render() {
        const total = filteredRows.length;
        const totalPages = clampPage();

        if (total === 0) {
          tbody.innerHTML = EMPTY_HTML(allRows.length === 0
            ? "No stock transactions recorded."
            : "No matching transactions.");
          if (pagerBar) pagerBar.hidden = true;
          return;
        }

        const startIdx = (page - 1) * pageSize;
        const rows = filteredRows.slice(startIdx, startIdx + pageSize);

        tbody.innerHTML = "";
        rows.forEach(r => tbody.appendChild(r));

        renderPager(totalPages);
      }

      function applyFilterSort(resetToFirstPage = true) {
        const keyword = (q?.value || "").trim().toLowerCase();
        const type = typeSelect?.value || "";
        const sort = sortSelect?.value || "new";

        filteredRows = allRows.filter(tr => {
          const item = (tr.dataset.item || "").toLowerCase();
          const batch = (tr.dataset.batch || "").toLowerCase();
          const remark = (tr.dataset.remark || "").toLowerCase();
          const user = (tr.dataset.user || "").toLowerCase();
          const t = (tr.dataset.type || "");

          const matchText = !keyword || item.includes(keyword) || batch.includes(keyword) || remark.includes(keyword) || user.includes(keyword);
          const matchType = !type || t === type;

          return matchText && matchType;
        });

        filteredRows.sort((a, b) => {
          if (sort === "new" || sort === "old") {
            const ad = Date.parse(a.dataset.date || "");
            const bd = Date.parse(b.dataset.date || "");
            return sort === "new" ? (bd - ad) : (ad - bd);
          }

          if (sort === "item_az" || sort === "item_za") {
            const an = (a.dataset.item || "").toLowerCase();
            const bn = (b.dataset.item || "").toLowerCase();
            if (an < bn) return sort === "item_az" ? -1 : 1;
            if (an > bn) return sort === "item_az" ? 1 : -1;
            return 0;
          }

          const aq = parseFloat(a.dataset.qty || "0");
          const bq = parseFloat(b.dataset.qty || "0");
          return sort === "qty_asc" ? (aq - bq) : (bq - aq);
        });

        if (resetToFirstPage) page = 1;
        render();
      }

      /* =========================================================
         Events
      ========================================================== */
      btnFilter?.addEventListener("click", () => applyFilterSort(true));

      btnReset?.addEventListener("click", () => {
        if (q) q.value = "";
        if (typeSelect) typeSelect.value = "";
        if (sortSelect) sortSelect.value = "new";
        filteredRows = [...allRows];
        page = 1;
        render();
      });

      q?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          applyFilterSort(true);
        }
      });

      pageSizeEl?.addEventListener("change", () => {
        pageSize = parseInt(pageSizeEl.value || "50", 10);
        page = 1;
        render();
      });

      // ✅ initial render
      render();

    })();
</script>

