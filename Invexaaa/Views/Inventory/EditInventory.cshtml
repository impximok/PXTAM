@model Invexaaa.Models.ViewModels.InventoryEditViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Edit Inventory Cost";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --bg: #ffffff;
        --card: #ffffff;
        --border: #e6e7eb;
        --text: #111827;
        --muted: #6b7280;
        --radius: 22px;
        --danger: #dc2626;
    }

    /* Force full layout background to white */
    html, body, main,
    .container-fluid, .content, .content-body,
    .app-content, .app-wrapper {
        background: #ffffff !important;
    }

    /* Page wrapper */
    .cost-page {
        min-height: calc(100vh - 120px);
        display: grid;
        place-items: center;
        padding: 20px 16px;
        background: var(--bg);
        align-items: start;
        padding-top: 26px;
    }

    .cost-card {
        width: min(980px, 100%);
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: 0 10px 28px rgba(0,0,0,.06);
        overflow: hidden;
        transform: scale(0.95);
        transform-origin: top center;
    }

    .cost-inner {
        padding: 22px 28px 18px;
    }

    .cost-title {
        font-size: 34px;
        line-height: 1.05;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0;
        color: var(--text);
    }

    .cost-subtitle {
        margin: 8px 0 0;
        font-size: 14px;
        color: var(--muted);
    }

    .top-divider {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 18px 0 0;
    }

    /* ===============================
               ONE SPACING SYSTEM (fix weird rhythm)
               =============================== */
    .section {
        display: grid;
        gap: 16px; /* consistent spacing inside a section */
        padding: 22px 0; /* section padding top/bottom */
    }

        .section + .section {
            border-top: 1px solid var(--border); /* obvious separation */
        }

    .section-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        margin: 0; /* gap handles spacing */
    }

    /* ===============================
               Item Details - display strip
               =============================== */
    .info-strip {
        border: 2px solid var(--border);
        border-radius: 18px;
        background: #fff;
        display: grid;
        grid-template-columns: 1.3fr 1fr 1fr;
        overflow: hidden;
    }

    .info-cell {
        padding: 14px 16px;
    }

        .info-cell + .info-cell {
            border-left: 2px solid var(--border);
        }

    .info-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .info-value {
        font-size: 16px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
        word-break: break-word;
    }

    /* ===============================
               Inputs + validation
               =============================== */
    .field-block {
        display: grid;
        gap: 10px; /* tighter than section gap */
    }

    .field-label {
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        margin: 0;
    }

    .req {
        color: var(--danger);
        font-weight: 700;
        margin-left: 6px;
    }

    .form-control {
        border: 2px solid var(--border) !important;
        border-radius: 18px !important;
        padding: 12px 14px !important;
        font-size: 16px !important;
        color: var(--text) !important;
        background: #fff !important;
        box-shadow: none !important;
        outline: none !important;
    }

        /* Remove blue focus glow (browser + Bootstrap) */
        .form-control:focus,
        .form-control:focus-visible,
        input:focus,
        input:focus-visible,
        select:focus,
        textarea:focus {
            outline: none !important;
            box-shadow: none !important;
            border-color: #000 !important;
        }

        /* Validation error -> red border */
        .form-control.input-validation-error {
            border-color: var(--danger) !important;
        }

            .form-control.input-validation-error:focus {
                border-color: var(--danger) !important;
            }

    /* Inline RM inside input */
    .money-input {
        position: relative;
    }

    .money-inline {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 14px;
        font-weight: 700;
        color: var(--muted);
        pointer-events: none;
    }

    .money-field {
        padding-left: 44px !important; /* space for RM */
    }

    /* Note box (quiet) */
    .field-note {
        border: 1px solid var(--border);
        background: #fafafa;
        border-radius: 14px;
        padding: 10px 12px;
        font-size: 14px;
        color: var(--muted);
        line-height: 1.45;
    }

        .field-note b {
            color: var(--text);
        }

    /* ===============================
               Preview result (distinct)
               =============================== */
    .preview-result {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 18px;
        border-radius: 18px;
        background: #fff;
        border: 2px solid #000;
    }

    .preview-meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .preview-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
    }

    .preview-sub {
        font-size: 13px;
        color: var(--muted);
    }

    .preview-amount {
        font-size: 18px;
        font-weight: 900;
        color: var(--text);
        white-space: nowrap;
    }

    /* ===============================
               Actions (footer-like)
               =============================== */
    .actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-top: 10px;
        padding-top: 18px;
        border-top: 1px solid var(--border);
    }

    .pill-btn {
        border-radius: 999px !important;
        padding: 12px 16px !important;
        font-weight: 800 !important;
        font-size: 16px !important;
        border: 2px solid #000 !important;
        text-align: center;
        transition: background-color 220ms ease, color 220ms ease, border-color 220ms ease;
        user-select: none;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .pill-solid {
        background: #000 !important;
        color: #fff !important;
    }

    .pill-outline {
        background: transparent !important;
        color: #000 !important;
    }

    .pill-solid:hover,
    .pill-solid:focus-visible {
        background: #fff !important;
        color: #000 !important;
        border-color: #000 !important;
        box-shadow: none !important;
    }

    .pill-outline:hover,
    .pill-outline:focus-visible {
        background: #000 !important;
        color: #fff !important;
        border-color: #000 !important;
        box-shadow: none !important;
    }

    button:disabled {
        opacity: .7;
        cursor: not-allowed;
    }

    /* Responsive */
    @@media (max-width: 900px) {
        .cost-inner {
            padding: 26px 20px 18px;
        }

        .info-strip {
            grid-template-columns: 1fr;
        }

        .info-cell + .info-cell {
            border-left: 0;
            border-top: 2px solid var(--border);
        }

        .actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cost-page">
    <div class="cost-card">
        <div class="cost-inner">

            <h1 class="cost-title">Edit Standard Cost</h1>
            <p class="cost-subtitle">
                Administrative cost maintenance for <b>Fixed Costing</b> items.
            </p>

            <hr class="top-divider" />

            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="InventoryID" />
                <input type="hidden" asp-for="ItemID" />

                <!-- ===============================
                     SECTION: Item Details
                     =============================== -->
                <div class="section">
                    <div class="section-title">Item Details</div>

                    <div class="info-strip">
                        <div class="info-cell">
                            <div class="info-label">Item</div>
                            <div class="info-value">@Model.ItemName</div>
                        </div>

                        <div class="info-cell">
                            <div class="info-label">Costing Method</div>
                            <div class="info-value">Fixed Costing</div>
                        </div>

                        <div class="info-cell">
                            <div class="info-label">Current Quantity</div>
                            <div class="info-value">@Model.InventoryTotalQuantity</div>
                        </div>
                    </div>
                </div>

                <!-- ===============================
                     SECTION: Standard Cost
                     =============================== -->
                <div class="section">
                    <div class="field-block">
                        <label class="field-label">
                            Standard Unit Cost <span class="req">*</span>
                        </label>

                        <div class="money-input">
                            <span class="money-inline">RM</span>
                            <input asp-for="StandardUnitCost"
                                   type="number"
                                   step="0.0001"
                                   min="0"
                                   class="form-control money-field"
                                   placeholder="0.00" />
                        </div>

                        <span asp-validation-for="StandardUnitCost" class="text-danger small"></span>
                    </div>

                    <div class="field-note">
                        This cost will be used for <b>all inventory valuation</b>.<br />
                        Stock IN will <b>not</b> modify this value.
                    </div>

                    <div class="preview-result" aria-live="polite">
                        <div class="preview-meta">
                            <div class="preview-title">New Total Stock Value</div>
                            <div class="preview-sub">Based on current quantity × new unit cost</div>
                        </div>
                        <div class="preview-amount" id="previewValue">RM 0.00</div>
                    </div>

                    <div class="actions">
                        <a asp-action="InventoryIndex" class="pill-btn pill-outline">
                            Cancel
                        </a>

                        <button type="submit"
                                class="pill-btn pill-solid"
                                id="updateBtn"
                                data-text="Update"
                                data-loading="Updating…">
                            Update
                        </button>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const form = document.querySelector('form');
        const btn = document.getElementById('updateBtn');

        const costInput = document.querySelector('[name="StandardUnitCost"]');
        const qty = Number(@Model.InventoryTotalQuantity);
        const preview = document.getElementById('previewValue');

        function formatMoneyRM(value) {
            const num = Number(value);
            if (Number.isNaN(num)) return "RM 0.00";
            return "RM " + num.toLocaleString('en-MY', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function updatePreview() {
            const cost = parseFloat(costInput?.value);
            if (!Number.isNaN(cost) && qty >= 0) {
                preview.innerText = formatMoneyRM(cost * qty);
            } else {
                preview.innerText = "RM 0.00";
            }
        }

        costInput?.addEventListener('input', updatePreview);
        updatePreview();

        if (form && btn) {
            form.addEventListener('submit', () => {
                btn.textContent = btn.dataset.loading;
                btn.disabled = true;
            });
        }
    </script>
}
