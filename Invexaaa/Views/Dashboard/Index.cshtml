@model Invexaaa.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<style>
    /* ===============================
                           INVEXA · BLACK & WHITE SYSTEM
                        =============================== */
    :root {
        --bg: #ffffff;
        --card: #ffffff;
        --text: #111827;
        --muted: #6b7280;
        --border: #e6e7eb;
        --soft: #f6f7f9;
        --shadow: 0 10px 24px rgba(0,0,0,.06);
        --radius: 18px;
        --focus: 0 0 0 4px rgba(17,17,17,.08);
        --ok: #22c55e;
        --warn: #f59e0b;
        --danger: #ef4444;
        --danger2: #7f1d1d;
    }

    html, body, main,
    .container-fluid, .content, .content-body,
    .app-content, .app-wrapper {
        background: var(--bg) !important;
    }

    .dash-wrap {
        width: 100%;
        padding: 10px 18px 28px;
    }

    /* Header */
    .dash-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 16px;
    }

    .dash-title {
        margin: 0;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: 0.2px;
        color: var(--text);
    }

    .dash-sub {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 14px;
    }

    .dash-chip {
        border: 1px solid var(--border);
        background: #fff;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        color: var(--muted);
        font-weight: 700;
        white-space: nowrap;
    }

    /* Stats */
    .dash-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 16px;
    }

    @@media (max-width: 1200px) {
        .dash-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 680px) {
        .dash-stats {
            grid-template-columns: 1fr;
        }
    }

    .stat-card {
        background: var(--card);
        border: 2px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 14px 16px;
        min-height: 98px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .stat-label {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.2px;
    }

    .stat-value {
        margin: 6px 0 0;
        font-size: 28px;
        font-weight: 900;
        color: var(--text);
        line-height: 1.1;
    }

    .stat-meta {
        margin-top: 6px;
        font-size: 12px;
        color: var(--muted);
        font-weight: 600;
    }

    .t-ok {
        color: var(--ok);
    }

    .t-warn {
        color: var(--warn);
    }

    .t-danger {
        color: var(--danger);
    }

    /* Main layout */
    .dash-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 14px;
        align-items: start;
    }

    @@media (max-width: 1100px) {
        .dash-grid {
            grid-template-columns: 1fr;
        }
    }

    .panel {
        background: var(--card);
        border: 2px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 16px 18px;
    }

    .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .panel-title {
        margin: 0;
        font-weight: 900;
        letter-spacing: 0.2px;
        color: var(--text);
        font-size: 16px;
    }

    .panel-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        position: relative;
    }

    @@media (max-width: 560px) {
        .panel-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .panel-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    /* Table */
    .sys-table-wrap {
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
    }

    table.sys-table {
        width: 100%;
        border-collapse: collapse;
    }

    .sys-table thead th {
        background: var(--soft);
        color: var(--muted);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        padding: 12px 14px;
        border-bottom: 1px solid var(--border);
    }

    .sys-table tbody td {
        padding: 12px 14px;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
        color: var(--text);
        vertical-align: middle;
    }

    .sys-table tbody tr:last-child td {
        border-bottom: none;
    }

    .inactive-row {
        opacity: .72;
    }

    .badge-soft {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--muted);
        font-weight: 800;
        font-size: 11px;
        border-radius: 999px;
        padding: 4px 8px;
    }

    /* Quick insights row */
    .dash-insights {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 16px;
    }

    @@media (max-width: 1100px) {
        .dash-insights {
            grid-template-columns: 1fr;
        }
    }

    .insight {
        background: #fff;
        border: 2px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 12px 14px;
    }

    .insight-label {
        font-size: 12px;
        font-weight: 800;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .insight-value {
        margin-top: 6px;
        font-size: 20px;
        font-weight: 900;
        color: var(--text);
        line-height: 1.15;
    }

    .insight-meta {
        margin-top: 4px;
        font-size: 12px;
        color: var(--muted);
        font-weight: 600;
    }

    /* Search + Filter row */
    .stock-tools {
        display: flex;
        gap: 10px;
        align-items: center;
        justify-content: space-between;
        margin: 10px 0 12px;
        flex-wrap: wrap;
    }

    .stock-search {
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 8px 10px;
        background: #fff;
        min-width: 260px;
    }

        .stock-search i {
            color: var(--muted);
            font-size: 14px;
        }

        .stock-search input {
            border: 0;
            outline: 0;
            width: 220px;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

    /* Segmented buttons */
    .seg {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .seg-btn {
        border: 2px solid var(--border);
        background: #fff;
        color: #111;
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 12.5px;
        font-weight: 800;
        cursor: pointer;
        transition: background-color .12s ease, transform .08s ease, box-shadow .12s ease, border-color .12s ease;
    }

        .seg-btn:hover {
            background: #111;
            border: 2px solid #000;
            color: #fff;
        }

        .seg-btn.is-on {
            border: 2px solid var(--border);
        }

    /* Filter icon button */
    .icon-btn {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: #fff;
        color: #111;
        border: 2px solid var(--border);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background-color .12s ease, transform .08s ease, box-shadow .12s ease;
    }

        .icon-btn:hover {
            background: #111;
            border: 2px solid #000;
            color: #fff;
        }

        .icon-btn.sm {
            width: 32px;
            height: 32px;
            border-radius: 10px;
        }

    /* Popover */
    .filter-pop {
        position: absolute;
        right: 0;
        top: calc(100% + 10px);
        width: 260px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 12px;
        display: none;
        z-index: 100;
        box-shadow: var(--shadow);
    }

        .filter-pop.open {
            display: block;
        }

    .filter-pop-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
    }

    .filter-pop-title {
        font-weight: 900;
        color: var(--text);
        letter-spacing: .2px;
    }

    .filter-group {
        margin-top: 12px;
    }

    .filter-label {
        font-size: 12px;
        font-weight: 800;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .3px;
        margin-bottom: 8px;
    }

    /* Legend dots */
    .dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        border: 1px solid rgba(0,0,0,.12);
    }

        .dot.ok {
            background: var(--ok);
        }

        .dot.low {
            background: var(--warn);
        }

        .dot.reorder {
            background: var(--danger);
        }

        .dot.out {
            background: var(--danger2);
        }

    /* ===== Stock Overview V2 ===== */
    .chart-wrap {
        padding-top: 2px;
    }

    .chart-box {
        position: relative;
        display: grid;
        place-items: center;
        margin: 6px 0 10px;
        width: 260px;
        height: 260px;
        margin-left: auto;
        margin-right: auto;
    }

        .chart-box canvas {
            width: 260px !important;
            height: 260px !important;
        }

    .chart-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        pointer-events: none;
        transform: translateY(-2px);
    }

    .cc-top {
        font-size: 11px;
        font-weight: 900;
        letter-spacing: .35px;
        color: var(--muted);
        margin: 0 0 6px 0;
    }

    .cc-main {
        font-size: 38px;
        font-weight: 950;
        color: var(--text);
        line-height: 1;
        margin: 0;
    }

    .cc-sub {
        font-size: 12px;
        font-weight: 800;
        color: var(--muted);
        margin: 8px 0 0 0;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .legend-click {
        display: grid;
        gap: 10px;
        margin-top: 6px;
    }

    .legend-row {
        border: 1px solid var(--border);
        background: #fff;
        border-radius: 14px;
        padding: 10px 12px;
        display: grid;
        grid-template-columns: 14px 1fr auto;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        transition: transform .08s ease, box-shadow .12s ease, border-color .12s ease, background-color .12s ease;
    }

        .legend-row:hover {
            border-color: #d1d5db;
            box-shadow: 0 10px 24px rgba(0,0,0,.06);
            transform: translateY(-1px);
        }

        .legend-row:focus {
            outline: none;
            box-shadow: var(--focus);
        }

        .legend-row.is-dim {
            opacity: .42;
            transform: none;
            box-shadow: none;
        }

        .legend-row.is-focused {
            border-color: #111;
            box-shadow: 0 12px 28px rgba(0,0,0,.10);
        }

    .k {
        font-size: 13px;
        font-weight: 900;
        color: var(--text);
    }

    .legend-row .right {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .pct {
        font-size: 12px;
        font-weight: 900;
        color: var(--muted);
    }

    .v {
        font-size: 13px;
        font-weight: 900;
        color: var(--text);
        padding: 5px 10px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: #fff;
        min-width: 48px;
        text-align: center;
    }

    .legend-note {
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid var(--border);
        font-size: 12px;
        color: var(--muted);
        font-weight: 600;
        text-align: center;
    }

    /* ✅ aligned stack for bottom sections */
    .left-stack {
        display: grid;
        gap: 14px;
        margin-top: 14px;
    }

    /* ✅ sub panels (instead of nesting .panel inside .panel) */
    .subpanel {
        background: #fff;
        border: 2px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 14px;
    }

    .chart-box {
        position: relative;
        display: grid;
        place-items: center;
        /* ✅ give room for hoverOffset */
        width: 300px;
        height: 300px;
        margin: 6px auto 10px;
        padding: 18px; /* ✅ key */
        overflow: visible; /* ✅ key */
    }

        .chart-box canvas {
            width: 100% !important;
            height: 100% !important;
        }

</style>

<div class="dash-wrap">

    <!-- HEADER -->
    <div class="dash-head">
        <div>
            <h2 class="dash-title">Dashboard</h2>
            <p class="dash-sub">Overview of inventory health and recent activity.</p>
        </div>
        <span class="dash-chip">Authorized User</span>
    </div>

    <!-- STATS (KEEP) -->
    <div class="dash-stats">
        <div class="stat-card">
            <p class="stat-label">Total Items</p>
            <div class="stat-value">@Model.TotalItems</div>
            <div class="stat-meta">Active @Model.ActiveItemCount · Inactive @Model.InactiveItemCount</div>
        </div>

        <div class="stat-card">
            <p class="stat-label">Low Stock</p>
            <div class="stat-value t-warn">@Model.LowStockCount</div>
            <div class="stat-meta">Items at/below reorder level</div>
        </div>

        <div class="stat-card">
            <p class="stat-label">Out of Stock</p>
            <div class="stat-value t-danger">@Model.OutOfStockCount</div>
            <div class="stat-meta">Items with zero quantity</div>
        </div>

        <div class="stat-card">
            <p class="stat-label">Reorder Alerts</p>
            <div class="stat-value t-danger">@Model.ReorderAlertCount</div>
            <div class="stat-meta">Below reorder point</div>
        </div>
    </div>



    <!-- MAIN -->
    <div class="dash-grid">

        <!-- LEFT: STOCK LIST + NEW SECTIONS -->
        <div class="panel">
            <div class="panel-head">
                <h5 class="panel-title">Stock List</h5>
            </div>

            <div class="stock-tools">
                <div class="stock-search">
                    <i class="bi bi-search"></i>
                    <input id="stockSearch" type="text" placeholder="Search item name..." />
                </div>

                <div class="seg stock-filter">
                    <button type="button" class="seg-btn is-on" data-filter="ALL">All</button>
                    <button type="button" class="seg-btn" data-filter="OK">OK</button>
                    <button type="button" class="seg-btn" data-filter="Low">Low</button>
                    <button type="button" class="seg-btn" data-filter="Reorder">Reorder</button>
                    <button type="button" class="seg-btn" data-filter="Out">Out</button>
                </div>
            </div>

            <div class="sys-table-wrap">
                <table class="sys-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th style="width:140px;">Quantity</th>
                            <th style="width:140px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentInventories)
                        {
                            bool isInactive = item.ItemStatus == "Inactive";
                            var statusClass = item.Status == "OK"
                            ? "t-ok"
                            : item.Status == "Low"
                            ? "t-warn"
                            : "t-danger";

                            <tr class="@(isInactive ? "inactive-row" : "")"
                                data-name="@item.ItemName"
                                data-status="@item.Status"
                                data-active="@(isInactive ? "0" : "1")">
                                <td>
                                    <strong>@item.ItemName</strong>
                                    @if (isInactive)
                                    {
                                        <span class="badge-soft ms-2">INACTIVE</span>
                                    }
                                </td>
                                <td>@item.Quantity</td>
                                <td class="@statusClass"><strong>@item.Status</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Extra mini cards BELOW stock list (Business + Action) -->
            <div class="dash-insights" style="margin-top:14px;">
                <div class="insight">
                    <div class="insight-label">Today Sales</div>
                    <div class="insight-value">RM @Model.TodaySales.ToString("0.00")</div>
                    <div class="insight-meta">@Model.TodayOrders order(s) · Avg RM @Model.AvgOrderValueToday.ToString("0.00")</div>
                </div>

                <div class="insight">
                    <div class="insight-label">This Month Sales</div>
                    <div class="insight-value">RM @Model.MonthSales.ToString("0.00")</div>
                    <div class="insight-meta">Month-to-date</div>
                </div>

                <div class="insight">
                    <div class="insight-label">Reorder Cost Est.</div>
                    <div class="insight-value">RM @Model.TotalReorderCostEstimate.ToString("0.00")</div>
                    <div class="insight-meta">Top suggested orders</div>
                </div>
            </div>

            <!-- Top Selling -->
            <div class="panel" style="margin-top:14px; padding:14px 14px;">
                <div class="panel-head" style="margin-bottom:8px;">
                    <h5 class="panel-title">Top Selling (Last 7 Days)</h5>
                </div>

                <div class="sys-table-wrap">
                    <table class="sys-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th style="width:120px;">Qty</th>
                                <th style="width:160px;">Sales</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopSellingItems?.Any() == true)
                            {
                                foreach (var x in Model.TopSellingItems)
                                {
                                    <tr>
                                        <td><strong>@x.ItemName</strong></td>
                                        <td>@x.QtySold</td>
                                        <td>RM @x.SalesAmount.ToString("0.00")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" style="color: var(--muted); font-weight:700;">No sales data in this period</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Reorder Planner -->
            <div class="panel" style="margin-top:14px; padding:14px 14px;">
                <div class="panel-head" style="margin-bottom:8px;">
                    <h5 class="panel-title">Reorder Planner</h5>
                </div>

                <div class="sys-table-wrap">
                    <table class="sys-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th style="width:90px;">Qty</th>
                                <th style="width:110px;">Target</th>
                                <th style="width:130px;">Suggest</th>
                                <th style="width:150px;">Est. Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ReorderPlanner?.Any() == true)
                            {
                                foreach (var r in Model.ReorderPlanner)
                                {
                                    var target = r.ReorderPoint + r.SafetyStock;

                                    <tr>
                                        <td>
                                            <strong>@r.ItemName</strong>
                                            <div style="font-size:12px; color:var(--muted); font-weight:700;">
                                                ROP @r.ReorderPoint · SS @r.SafetyStock · ADD @r.AverageDailyDemand
                                                @if (r.RunoutDays.HasValue)
                                                {
                                                    <span> · ~@Math.Round(r.RunoutDays.Value, 1) days left</span>
                                                }
                                            </div>
                                        </td>
                                        <td>@r.CurrentQty</td>
                                        <td>@target</td>
                                        <td><strong>@r.SuggestedOrderQty</strong></td>
                                        <td>RM @r.EstimatedCost.ToString("0.00")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" style="color: var(--muted); font-weight:700;">No reorder suggestions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- RIGHT: STOCK OVERVIEW (V2) -->
        <div class="panel stock-card">
            <div class="panel-head">
                <h5 class="panel-title">Stock Overview</h5>

                <div class="panel-actions">
                    <button type="button" class="icon-btn" id="btnStockFilters" aria-expanded="false" aria-label="Filters">
                        <i class="bi bi-sliders"></i>
                    </button>

                    <div class="filter-pop" id="stockFilterPop">
                        <div class="filter-pop-head">
                            <div class="filter-pop-title">Filters</div>
                            <button type="button" class="icon-btn sm" id="btnCloseFilters" aria-label="Close">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="filter-group">
                            <div class="filter-label">Range</div>
                            <div class="seg">
                                <button type="button" class="seg-btn is-on" data-range="current">Current</button>
                                <button type="button" class="seg-btn" data-range="7d">7D</button>
                                <button type="button" class="seg-btn" data-range="30d">30D</button>
                                <button type="button" class="seg-btn" data-range="90d">90D</button>
                            </div>
                        </div>

                        <div class="filter-group">
                            <div class="filter-label">Chart</div>
                            <div class="seg">
                                <button type="button" class="seg-btn is-on" data-type="doughnut">Doughnut</button>
                                <button type="button" class="seg-btn" data-type="bar">Bar</button>
                            </div>
                        </div>

                        <input type="hidden" id="chartRange" value="current" />
                        <input type="hidden" id="chartType" value="doughnut" />
                    </div>
                </div>
            </div>

            <div class="chart-wrap">
                <div class="chart-box">
                    <canvas id="stockChart" width="240" height="240"></canvas>

                    <div class="chart-center" id="chartCenter">
                        <div class="cc-top">TOTAL</div>
                        <div class="cc-main" id="ccTotal">0</div>
                        <div class="cc-sub" id="ccHint">Active items</div>
                    </div>
                </div>
            </div>

            <div class="legend-click" id="stockLegend">
                <button type="button" class="legend-row" aria-pressed="true">
                    <span class="dot ok"></span>
                    <span class="k">Ok</span>
                    <span class="right">
                        <span class="pct" data-pct="ok">0%</span>
                        <span class="v">@Model.OkStockCount</span>
                    </span>
                </button>

                <button type="button" class="legend-row" aria-pressed="true">
                    <span class="dot low"></span>
                    <span class="k">Low</span>
                    <span class="right">
                        <span class="pct" data-pct="low">0%</span>
                        <span class="v">@Model.LowStockCount</span>
                    </span>
                </button>

                <button type="button" class="legend-row" aria-pressed="true">
                    <span class="dot reorder"></span>
                    <span class="k">Reorder</span>
                    <span class="right">
                        <span class="pct" data-pct="reorder">0%</span>
                        <span class="v">@Model.ReorderAlertCount</span>
                    </span>
                </button>

                <button type="button" class="legend-row" aria-pressed="true">
                    <span class="dot out"></span>
                    <span class="k">Out</span>
                    <span class="right">
                        <span class="pct" data-pct="out">0%</span>
                        <span class="v">@Model.OutOfStockCount</span>
                    </span>
                </button>
            </div>

            <div class="legend-note">
                Tip: click a status to focus · click again to reset
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // ===============================
    // STOCK CHART (V2)
    // ===============================
    const chartEl = document.getElementById('stockChart');

    const labels = ['OK', 'Low', 'Reorder', 'Out'];
    const values = [
        @Model.OkStockCount,
        @Model.LowStockCount,
        @Model.ReorderAlertCount,
        @Model.OutOfStockCount
    ];

    const colors = ['#22c55e', '#f59e0b', '#ef4444', '#7f1d1d'];

    const ccTotal = document.getElementById('ccTotal');
    const ccHint = document.getElementById('ccHint');

    function sum(arr) { return arr.reduce((a, b) => a + (Number(b) || 0), 0); }
    function pct(v, total) {
        if (!total) return 0;
        return Math.round((v * 100) / total);
    }

    function updateCenter(label, value, percentText) {
        const top = document.querySelector('.cc-top');
        const main = document.querySelector('.cc-main');
        const sub = document.querySelector('.cc-sub');

        top.textContent = label.toUpperCase();
        main.textContent = value;
        sub.textContent = percentText;
    }

    function renderPercents() {
        const total = sum(values);

        // Default center
        updateCenter('Total', total, total === 0 ? 'No active data' : 'Active items');

        const map = { ok: values[0], low: values[1], reorder: values[2], out: values[3] };

        Object.keys(map).forEach(k => {
            const el = document.querySelector(`[data-pct="${k}"]`);
            if (el) el.textContent = `${pct(map[k], total)}%`;
        });
    }

    const baseDataset = () => ({
        label: 'Stock Status',
        data: values,
        backgroundColor: colors,
        borderWidth: 0,
        hoverOffset: 6
    });

    let stockChart = new Chart(chartEl, {
        type: 'doughnut',
        data: { labels, datasets: [baseDataset()] },
        options: {
            responsive: true,
            maintainAspectRatio: false,
              layout: { padding: 14 },   // ✅ give drawing padding
            cutout: '78%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: (ctx) => {
                            const total = sum(values);
                            const v = ctx.parsed;
                            return ` ${ctx.label}: ${v} (${pct(v, total)}%)`;
                        }
                    }
                }
            }
        }
    });

    renderPercents();

    function rebuildChart(newType) {
        stockChart.destroy();

        const isBar = newType === 'bar';

        stockChart = new Chart(chartEl, {
            type: newType,
            data: {
                labels,
                datasets: [{
                    ...baseDataset(),
                    borderRadius: isBar ? 10 : 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: isBar ? {
                    x: { ticks: { font: { weight: 800 } } },
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                } : {},
                cutout: isBar ? undefined : '74%'
            }
        });

        // IMPORTANT: chart-center is flex (not grid)
        document.getElementById('chartCenter').style.display = (newType === 'doughnut') ? 'flex' : 'none';

        focusedIndex = null;
        setLegendState(null);

        // reset center when coming back
        if (newType === 'doughnut') renderPercents();
    }

    // ===== Legend click → focus slice =====
    const legend = document.getElementById('stockLegend');
    let focusedIndex = null;

    function setLegendState(idx) {
        const rows = Array.from(legend.querySelectorAll('.legend-row'));
        rows.forEach((r, i) => {
            const isTarget = (idx === null) ? true : (i === idx);
            r.classList.toggle('is-dim', idx !== null && !isTarget);
            r.classList.toggle('is-focused', idx !== null && isTarget);
            r.setAttribute('aria-pressed', (idx === null || isTarget) ? 'true' : 'false');
        });
    }

    function hexToRgba(hex, a) {
        hex = hex.replace('#', '');
        const r = parseInt(hex.substring(0, 2), 16);
        const g = parseInt(hex.substring(2, 4), 16);
        const b = parseInt(hex.substring(4, 6), 16);
        return `rgba(${r},${g},${b},${a})`;
    }

    function applyFocus(idx) {
        if (stockChart.config.type !== 'doughnut') return;

        focusedIndex = (focusedIndex === idx) ? null : idx;

        const ds = stockChart.data.datasets[0];

        if (focusedIndex === null) {
            ds.backgroundColor = colors;
            ds.hoverOffset = 6;

            const total = sum(values);
            updateCenter('Total', total, total === 0 ? 'No active data' : 'Active items');
        } else {
            ds.backgroundColor = colors.map((c, i) =>
                i === focusedIndex ? c : hexToRgba(c, 0.18)
            );
            ds.hoverOffset = 10;

            const total = sum(values);
            const label = labels[focusedIndex];
            const val = values[focusedIndex];
            updateCenter(label, val, `${pct(val, total)}% of total`);
        }

        stockChart.update();
        setLegendState(focusedIndex);
    }

    legend?.querySelectorAll('.legend-row').forEach((row, idx) => {
        row.addEventListener('click', () => applyFocus(idx));
    });

    // ===============================
    // FILTER POPOVER TOGGLE
    // ===============================
    const btnStockFilters = document.getElementById('btnStockFilters');
    const pop = document.getElementById('stockFilterPop');
    const btnCloseFilters = document.getElementById('btnCloseFilters');
    const rangeHidden = document.getElementById('chartRange');
    const typeHidden = document.getElementById('chartType');

    function closePop() {
        pop?.classList.remove('open');
        btnStockFilters?.setAttribute('aria-expanded', 'false');
    }

    btnStockFilters?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = pop.classList.toggle('open');
        btnStockFilters.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    btnCloseFilters?.addEventListener('click', (e) => {
        e.stopPropagation();
        closePop();
    });

    document.addEventListener('click', () => closePop());
    pop?.addEventListener('click', (e) => e.stopPropagation());

    function setSegState(container, activeBtn) {
        container.querySelectorAll('.seg-btn').forEach(b => b.classList.remove('is-on'));
        activeBtn.classList.add('is-on');
    }

    document.querySelectorAll('[data-range]').forEach(btn => {
        btn.addEventListener('click', () => {
            rangeHidden.value = btn.dataset.range;
            setSegState(btn.closest('.seg'), btn);
            closePop();
            console.log('range:', rangeHidden.value);
        });
    });

    document.querySelectorAll('[data-type]').forEach(btn => {
        btn.addEventListener('click', () => {
            typeHidden.value = btn.dataset.type;
            setSegState(btn.closest('.seg'), btn);
            rebuildChart(typeHidden.value);
            closePop();
        });
    });

    // ===============================
    // STOCK LIST FILTERING
    // ===============================
    const stockSearch = document.getElementById('stockSearch');
    const rows = Array.from(document.querySelectorAll('.sys-table tbody tr'));
    let activeStatus = "ALL";

    function applyStockFilters() {
        const q = (stockSearch?.value || "").trim().toLowerCase();

        rows.forEach(r => {
            const name = (r.dataset.name || "").toLowerCase();
            const status = (r.dataset.status || "");
            const matchSearch = !q || name.includes(q);
            const matchStatus = (activeStatus === "ALL") || (status === activeStatus);

            r.style.display = (matchSearch && matchStatus) ? "" : "none";
        });
    }

    stockSearch?.addEventListener('input', applyStockFilters);

    document.querySelectorAll('.stock-filter [data-filter]').forEach(btn => {
        btn.addEventListener('click', () => {
            activeStatus = btn.dataset.filter;

            btn.closest('.stock-filter').querySelectorAll('.seg-btn').forEach(b => b.classList.remove('is-on'));
            btn.classList.add('is-on');

            applyStockFilters();
        });
    });

    applyStockFilters();
</script>
