@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Invexaaa.Models.ViewModels.AlertsDashboardViewModel

@{
    ViewData["Title"] = "Alerts & Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<div class="alerts-wrap">

    <!-- Header -->
    <div class="alerts-head">
        <div>
            <h2 class="page-title">Alerts</h2>
            <div class="page-sub">Expired, near expiry, low stock, and reorder needs.</div>
        </div>

        <!-- Keep the functionality: counts pill -->
        <div class="head-pills">
            <span class="pill"><i class="bi bi-x-circle"></i> Expired: <span id="pillExpired">@Model.ExpiredItems.Count()</span></span>
            <span class="pill"><i class="bi bi-hourglass"></i> Near: <span id="pillNear">@Model.NearExpiryItems.Count()</span></span>
            <span class="pill"><i class="bi bi-box"></i> Low: <span id="pillLow">@Model.LowStockItems.Count()</span></span>
            <span class="pill"><i class="bi bi-arrow-repeat"></i> Reorder: <span id="pillReorder">@Model.ReorderItems.Count()</span></span>

        </div>
    </div>
    <hr class="page-divider" />
    <!-- Toolbar: Search + Hide inactive -->
    <div class="alerts-tools">
        <div class="tool-search">
            <i class="bi bi-search"></i>
            <input id="alertsSearch"
                   type="text"
                   class="tool-input"
                   placeholder="Search batch / item name / item ID..."
                   autocomplete="off" />
        </div>

        <label class="tool-toggle" title="Hide inactive items">
            <input id="hideInactive" type="checkbox" />
            <span>Hide inactive</span>
        </label>
    </div>

    <div class="alerts-grid">

        <!-- ========== EXPIRED ========== -->
        <section class="alerts-column">
            <header class="column-header">
                <span>Expired</span>
                <div class="hdr-right">
                    <span class="mini-count" id="countExpired">@Model.ExpiredItems.Count()</span>


                    <i class="bi bi-x-circle"></i>
                </div>
            </header>

            <div class="column-body">
                @if (!Model.ExpiredItems.Any())
                {
                    <div class="empty">No expired batches</div>
                }
                else
                {
                    @foreach (var item in Model.ExpiredItems)
                    {
                        bool isInactive = item.ItemStatus == "Inactive";
                        var daysLeft = (item.ExpiryDate.Date - DateTime.Today).Days; // usually negative for expired
                        var severityClass = "sev-critical"; // expired always critical


                        <div class="card @severityClass @(isInactive ? "inactive-card" : "")"
                             data-col="expired"
                             data-inactive="@(isInactive ? "1" : "0")"
                             data-search="@($"{item.BatchNumber} {item.BatchID} {item.Quantity}").ToLowerInvariant()">

                            <div class="card-title">
                                @item.BatchNumber

                                @if (isInactive)
                                {
                                    <span class="inactive-badge">INACTIVE</span>
                                }
                            </div>

                            <div class="card-meta">
                                ID <b>@item.BatchID</b>
                                <span class="dot-sep">·</span>
                                Qty <b>@item.Quantity</b>
                            </div>

                            <div class="card-meta subtle">
                                Expired <b>@item.ExpiryDate.ToString("dd/MM/yyyy")</b>
                                <span class="dot-sep">·</span>
                                <b>@Math.Abs(daysLeft)</b> day(s) ago
                            </div>

                            <a asp-controller="Stock"
                               asp-action="StockIndex"
                               class="action">
                                View batch <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>
                    }
                }
            </div>
        </section>

        <!-- ========== NEAR EXPIRY ========== -->
        <section class="alerts-column">
            <header class="column-header">
                <span>Near Expiry</span>
                <div class="hdr-right">
                    <span class="mini-count" id="countNear">@Model.NearExpiryItems.Count()</span>

                    <i class="bi bi-hourglass"></i>
                </div>
            </header>

            <div class="column-body">
                @if (!Model.NearExpiryItems.Any())
                {
                    <div class="empty">Nothing expiring soon</div>
                }
                else
                {
                    @foreach (var item in Model.NearExpiryItems)
                    {
                        bool isInactive = item.ItemStatus == "Inactive";
                        var daysLeft = (item.ExpiryDate.Date - DateTime.Today).Days;

                        // Severity rules (edit if you want)
                        var severityClass = daysLeft <= 3 ? "sev-critical"
                        : daysLeft <= 7 ? "sev-warn"
                        : "sev-ok";


                        <div class="card @severityClass @(isInactive ? "inactive-card" : "")"
                             data-col="near"
                             data-inactive="@(isInactive ? "1" : "0")"
                             data-search="@($"{item.BatchNumber} {item.BatchID} {item.Quantity}").ToLowerInvariant()">

                            <div class="card-title">
                                Batch @item.BatchNumber

                                @if (isInactive)
                                {
                                    <span class="inactive-badge">INACTIVE</span>
                                }
                            </div>

                            <div class="card-meta">
                                ID @item.BatchID · Qty @item.Quantity
                            </div>

                            <div class="card-meta subtle">
                                Expires <b>@item.ExpiryDate.ToString("dd/MM/yyyy")</b>
                                <span class="dot-sep">·</span>
                                <b>@daysLeft</b> day(s) left
                            </div>


                            @if (!isInactive)
                            {
                                <a asp-controller="Stock"
                                   asp-action="StockIndex"
                                   class="action">
                                    Manage <i class="bi bi-arrow-right"></i>
                                </a>

                            }
                        </div>
                    }
                }
            </div>
        </section>

        <!-- ========== LOW STOCK ========== -->
        <section class="alerts-column">
            <header class="column-header">
                <span>Low Stock</span>
                <div class="hdr-right">
                    <span class="mini-count" id="countLow">@Model.LowStockItems.Count()</span>

                    <i class="bi bi-box"></i>
                </div>
            </header>

            <div class="column-body">
                @if (!Model.LowStockItems.Any())
                {
                    <div class="empty">Stock levels healthy</div>
                }
                else
                {
                    @foreach (var item in Model.LowStockItems)
                    {
                        bool isInactive = item.ItemStatus == "Inactive";

                        <div class="card @(isInactive ? "inactive-card" : "")"
                             data-col="low"
                             data-inactive="@(isInactive ? "1" : "0")"
                             data-search="@($"{item.ItemName} {item.ItemID} {item.TotalQuantity}").ToLowerInvariant()">

                            <div class="card-title">
                                @item.ItemName

                                @if (isInactive)
                                {
                                    <span class="inactive-badge">INACTIVE</span>
                                }
                            </div>

                            <div class="card-meta">
                                Item ID @item.ItemID
                            </div>

                            <div class="card-meta subtle">
                                Stock @item.TotalQuantity · Updated @item.LastUpdated.ToShortDateString()
                            </div>

                            @if (!isInactive)
                            {
                                <a asp-controller="Stock"
                                   asp-action="StockIndex"
                                   class="action">
                                    View inventory <i class="bi bi-arrow-right"></i>
                                </a>

                            }
                        </div>
                    }
                }
                <script>
                    (function () {
                        const search = document.getElementById("alertsSearch");
                        const hideInactive = document.getElementById("hideInactive");

                        function applyFilters() {
                            const q = (search.value || "").trim().toLowerCase();
                            const hide = hideInactive.checked;

                            document.querySelectorAll(".card").forEach(card => {
                                const s = (card.dataset.search || "");
                                const isInactive = card.dataset.inactive === "1";

                                const matchSearch = !q || s.includes(q);
                                const matchInactive = !hide || !isInactive;

                                card.style.display = (matchSearch && matchInactive) ? "" : "none";
                            });
                        }

                        search.addEventListener("input", applyFilters);
                        hideInactive.addEventListener("change", applyFilters);

                        // initial
                        applyFilters();
                    })();
                </script>

            </div>
        </section>

        <!-- ========== REORDER ========== -->
        <section class="alerts-column">
            <header class="column-header">
                <span>Reorder</span>
                <div class="hdr-right">
                    <span class="mini-count" id="countReorder">@Model.ReorderItems.Count()</span>

                    <i class="bi bi-arrow-repeat"></i>
                </div>
            </header>

            <div class="column-body">
                @if (!Model.ReorderItems.Any())
                {
                    <div class="empty">No reorder required</div>
                }
                else
                {
                    @foreach (var item in Model.ReorderItems)
                    {
                        bool isInactive = item.ItemStatus == "Inactive";

                        <div class="card @(isInactive ? "inactive-card" : "")"
                             data-col="reorder"
                             data-inactive="@(isInactive ? "1" : "0")"
                             data-search="@($"{item.ItemName} {item.CurrentBalance} {item.ReorderLevel}").ToLowerInvariant()">

                            <div class="card-title">
                                @item.ItemName

                                @if (isInactive)
                                {
                                    <span class="inactive-badge">INACTIVE</span>
                                }
                            </div>

                            <div class="card-meta">
                                Balance @item.CurrentBalance · Reorder @item.ReorderLevel
                            </div>

                            <div class="card-meta subtle">
                                Safety stock @item.SafetyStock
                            </div>

                            @if (!isInactive)
                            {
                                <a asp-controller="Stock"
                                   asp-action="StockIndex"
                                   class="action">
                                    Restock <i class="bi bi-arrow-right"></i>
                                </a>

                            }
                        </div>
                    }
                }
            </div>
        </section>

    </div>
</div>

<style>
    /* ========= INVEXA SIMPLE (KEEP YOUR ORIGINAL FEEL) ========= */
    :root {
        --bg: #ffffff;
        --card: #ffffff;
        --border: #e6e7eb;
        --text: #111827;
        --muted: #6b7280;
        --radius: 18px;
    }

    html, body, main,
    .container-fluid, .content, .content-body,
    .app-content, .app-wrapper {
        background: #ffffff !important;
    }

    .alerts-wrap {
        width: 100%;
        padding: 12px 18px 24px;
        background: var(--bg);
    }

    .alerts-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 14px;
        margin: 4px 0 16px;
        flex-wrap: wrap;
    }

    .page-title {
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.2px;
        color: var(--text);
        font-size: 34px;
    }

    .page-sub {
        margin-top: 6px;
        font-size: 13px;
        color: var(--muted);
    }

    /* Summary pills (functionality kept) */
    .head-pills {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--border);
        background: #fff;
        border-radius: 999px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
    }

        .pill i {
            opacity: .85;
        }

    /* Grid */
    .alerts-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    /* Columns */
    .alerts-column {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: #fff;
        height: 72vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .column-header {
        padding: 14px 18px;
        font-size: 14px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #f1f5f9;
        color: var(--text);
    }

    .hdr-right {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--muted);
    }

    .mini-count {
        font-size: 12px;
        font-weight: 700;
        color: var(--muted);
        border: 1px solid var(--border);
        background: #fff;
        padding: 3px 9px;
        border-radius: 999px;
    }

    .column-body {
        padding: 16px;
        overflow-y: auto;
    }

    /* Cards */
    .card {
        padding: 14px 16px;
        border-radius: 14px;
        background: #fafafa;
        border: 1px solid #ededed;
        margin-bottom: 14px;
    }

    .card-title {
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .card-meta {
        margin-top: 6px;
        font-size: 12px;
        color: #374151;
        line-height: 1.45;
    }

        .card-meta.subtle {
            color: var(--muted);
            margin-top: 4px;
        }

    .inactive-card {
        opacity: 0.55;
        filter: grayscale(100%);
    }

    .inactive-badge {
        background: #e5e7eb;
        color: #374151;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
    }

    /* Action */
    .action {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        font-size: 12px;
        font-weight: 600;
        color: #000;
        text-decoration: none;
    }

        .action:hover {
            text-decoration: underline;
        }

    .empty {
        font-size: 13px;
        color: #9ca3af;
        text-align: center;
        margin-top: 32px;
    }

    /* Divider */
    .page-divider {
        border: none;
        border-top: 1px solid var(--muted);
        margin: 14px 0 26px;
        opacity: .35;
    }

    .dot-sep {
        margin: 0 6px;
        color: var(--muted);
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .alerts-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .alerts-column {
            height: 62vh;
        }
    }

    @@media (max-width: 640px) {
        .alerts-grid {
            grid-template-columns: 1fr;
        }

        .head-pills {
            justify-content: flex-start;
        }
    }

    /* Toolbar */
    .alerts-tools {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin: 10px 0 16px;
    }

    .tool-search {
        flex: 1 1 320px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 10px 14px;
        background: #fff;
    }

        .tool-search i {
            color: var(--muted);
            font-size: 14px;
        }

        .tool-search:focus {
        }

    .tool-input {
        border: none;
        outline: none;
        width: 100%;
        font-size: 13px;
        color: var(--text);
    }

    .tool-toggle {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--border);
        background: #fff;
        border-radius: 999px;
        padding: 10px 12px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text);
        cursor: pointer;
        user-select: none;
    }

        .tool-toggle input {
            width: 16px;
            height: 16px;
            accent-color: #111;
        }

    /* Severity (black/white friendly) */
    .card {
        position: relative;
    }

    .sev-critical {
        border-left: 4px solid #111827;
    }

    .sev-warn {
        border-left: 4px solid #6b7280;
    }

    .sev-ok {
        border-left: 4px solid #cbd5e1;
    }

    .sev-critical,
    .sev-warn,
    .sev-ok {
        border-left: none !important;
    }
    /* Focus state — enterprise black */
    .tool-search:focus-within {
        border-color: #111827;
    }

    .tool-input:focus {
        outline: none;
    }

    /* Checkbox focus / active */
    .tool-toggle:focus-within {
        border-color: #111827;
    }

    .tool-toggle input:focus {
        outline: none;
    }

</style>
<script>
    (function () {
        const search = document.getElementById("alertsSearch");
        const hideInactive = document.getElementById("hideInactive");

        const countEls = {
            expired: document.getElementById("countExpired"),
            near: document.getElementById("countNear"),
            low: document.getElementById("countLow"),
            reorder: document.getElementById("countReorder"),
        };

        const pillEls = {
            expired: document.getElementById("pillExpired"),
            near: document.getElementById("pillNear"),
            low: document.getElementById("pillLow"),
            reorder: document.getElementById("pillReorder"),
        };

        function applyFilters() {
            const q = (search.value || "").trim().toLowerCase();
            const hide = hideInactive.checked;

            // reset counts
            const counts = { expired: 0, near: 0, low: 0, reorder: 0 };

            document.querySelectorAll(".card").forEach(card => {
                const s = (card.dataset.search || "");
                const isInactive = card.dataset.inactive === "1";
                const col = card.dataset.col; // expired/near/low/reorder

                const matchSearch = !q || s.includes(q);
                const matchInactive = !hide || !isInactive;

                const show = matchSearch && matchInactive;
                card.style.display = show ? "" : "none";

                if (show && counts[col] !== undefined) {
                    counts[col]++;
                }
            });

            // update mini-counts + pills
            Object.keys(counts).forEach(k => {
                if (countEls[k]) countEls[k].textContent = counts[k];
                if (pillEls[k]) pillEls[k].textContent = counts[k];
            });
        }

        search.addEventListener("input", applyFilters);
        hideInactive.addEventListener("change", applyFilters);

        applyFilters();
    })();
</script>
