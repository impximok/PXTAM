@model Invexaaa.Models.ViewModels.UpdateProfileViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Update Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string urlPath = string.IsNullOrWhiteSpace(Model.ProfileImageUrl)
        ? "/images/default-profile.png"
        : Model.ProfileImageUrl;

    string cacheBust = DateTime.UtcNow.Ticks.ToString();
}

<!-- IMPORTANT: NO CENTERING WRAPPER -->
<div class="profile-page">

    <div class="profile-card">
        <!-- HEADER -->
        <header class="profile-header">
            <h1 class="profile-title">Update Profile</h1>
            <p class="profile-subtitle">Manage your personal information and profile photo.</p>
        </header>

        @if (TempData["Info"] != null)
        {
            <div class="alert monocrome-alert text-center">
                @TempData["Info"]
            </div>
        }

        <form asp-action="UpdateProfile"
              asp-controller="User"
              method="post"
              enctype="multipart/form-data"
              novalidate>

            @Html.AntiForgeryToken()

            <!-- PROFILE IMAGE -->
            <section class="avatar-block">
                <div class="avatar-wrap">
                    <img id="avatarPreview"
                         src="@urlPath?v=@cacheBust"
                         class="ap-avatar"
                         alt="Profile picture" />
                </div>

                <div class="avatar-meta">
                    <label class="field-label">Profile Image</label>
                    <input type="hidden"
                           id="capturedData"
                           name="CapturedImageDataUrl" />


                    <input type="file"
                           id="fileInput"
                           name="ProfileImage"
                           accept="image/*"
                           class="file-input-hidden" />

                    <input type="file"
                           id="cameraInput"
                           accept="image/*"
                           capture
                           class="file-input-hidden" />


                    <div id="dropzone" class="dropzone" tabindex="0">
                        <div class="dz-main">
                            <div class="dz-icon">⬆︎</div>
                            <div class="dz-text">
                                <div class="dz-title">Upload a photo</div>
                                <div class="dz-sub">PNG / JPG · Max 2MB</div>
                            </div>
                        </div>
                    </div>

                    <div class="file-actions">
                        <button type="button" class="btn-ghost" id="browseBtn">Upload</button>
                        <button type="button" class="btn-ghost" id="cameraButton">Camera</button>
                        <span id="fileName" class="file-name">No file selected</span>
                    </div>
                </div>
            </section>

            <!-- EMAIL -->
            <div class="field">
                <label asp-for="Email" class="field-label">Email</label>
                <input asp-for="Email" class="text-input" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>


            <!-- NAME -->
            <div class="field">
                <label asp-for="Name" class="field-label">Display Name</label>
                <input asp-for="Name" class="text-input" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>


            <!-- ACTIONS -->
            <div class="actions">
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn-ghost">
                    Cancel
                </a>

                <button type="submit" class="btn-primary">
                    Save Changes
                </button>
            </div>
        </form>

        <!-- ================= IMAGE EDITOR MODAL ================= -->
        <div id="editorModal" class="editor hidden" aria-hidden="true">
            <div class="editor-box">
                <button type="button" class="editor-close" id="editorClose" aria-label="Close">✕</button>

                <!-- Circle preview -->
                <div class="editor-stage">
                    <div class="editor-circle">
                        <video id="cameraVideo"
                               autoplay
                               playsinline
                               class="hidden"
                               style="width:100%; height:100%; object-fit:cover;"></video>

                        <canvas id="editorCanvas" width="420" height="420"></canvas>

                        <div class="circle-guide"></div>
                    </div>
                </div>

                <!-- Zoom row (label left, slider right) -->
                <div class="zoom-row">
                    <div class="zoom-label">Zoom</div>
                    <input type="range" id="zoom" min="1" max="3" step="0.01" value="1">
                </div>

                <!-- Confirm row -->
                <div class="confirm-row">
                    <button type="button" class="btn-confirm" id="useImage">Confirm</button>
                </div>

                <!-- Rotate row -->
                <div class="rotate-row">
                    <button type="button" class="btn-round" id="rotateLeft">⟲</button>
                    <button type="button" class="btn-round" id="rotateRight">⟳</button>
                </div>
            </div>
        </div>


    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {

            const $ = id => document.getElementById(id);

            const fileInput = $('fileInput');
            const cameraInput = $('cameraInput');
            const browseBtn = $('browseBtn');
            const cameraBtn = $('cameraButton');

            const avatar = $('avatarPreview');
            const fileName = $('fileName');
            const captured = $('capturedData');

            const modal = $('editorModal');
            const closeBtn = $('editorClose');
            const canvas = $('editorCanvas');
            const ctx = canvas.getContext('2d');
            const video = $('cameraVideo');

            const zoomEl = $('zoom');
            const useBtn = $('useImage');
            const rotL = $('rotateLeft');
            const rotR = $('rotateRight');

            let img = null;
            let scale = 1;
            let rotation = 0;
            let offsetX = 0;
            let offsetY = 0;
            let dragging = false;
            let lastX = 0;
            let lastY = 0;
            let cameraStream = null;

            // ------------------ Modal ------------------

            function openEditor() {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }

            function closeEditor() {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
                stopCamera();
                video.classList.add('hidden');
                canvas.classList.remove('hidden');
            }

            function stopCamera() {
                if (cameraStream) {
                    cameraStream.getTracks().forEach(t => t.stop());
                    cameraStream = null;
                }
            }

            // ------------------ Drawing ------------------

                    function draw() {

            if (!img) return;

            const w = canvas.width;
            const h = canvas.height;

            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = "#fff";
            ctx.fillRect(0, 0, w, h);

            const iw = img.naturalWidth || img.width;
            const ih = img.naturalHeight || img.height;

            if (!iw || !ih) return;

            const base = Math.max(w / iw, h / ih);

            ctx.save();
            ctx.translate(w / 2 + offsetX, h / 2 + offsetY);
            ctx.rotate(rotation);
            ctx.scale(scale, scale);

            ctx.drawImage(
                img,
                -iw * base / 2,
                -ih * base / 2,
                iw * base,
                ih * base
            );

            ctx.restore();
        }


                    function loadImage(dataUrl) {

            const image = new Image();

            // VERY IMPORTANT
            image.crossOrigin = "anonymous";

            image.onload = () => {

                // Force image to be fully decoded before drawing
                image.decode().then(() => {

                    img = image;

                    scale = 1;
                    rotation = 0;
                    offsetX = 0;
                    offsetY = 0;
                    zoomEl.value = 1;

                    draw();
                    openEditor();

                }).catch(() => {
                    img = image;
                    draw();
                    openEditor();
                });
            };

            image.onerror = () => {
                alert("Image failed to load.");
            };

            image.src = dataUrl;
        }

            function loadFile(file) {
                if (!file) return;
                fileName.textContent = file.name;

                const reader = new FileReader();
                reader.onload = e => loadImage(e.target.result);
                reader.readAsDataURL(file);
            }

            // ------------------ Upload ------------------

            browseBtn.onclick = () => fileInput.click();
            fileInput.onchange = e => loadFile(e.target.files[0]);
            cameraInput.onchange = e => loadFile(e.target.files[0]);

            // ------------------ Camera ------------------

            cameraBtn.onclick = async () => {

                const isMobile = /Android|iPhone|iPad/i.test(navigator.userAgent);
                if (isMobile) {
                    cameraInput.click();
                    return;
                }

                try {

                    cameraStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: "user" }
                    });

                    video.srcObject = cameraStream;

                    await new Promise(resolve => {
                        video.onloadedmetadata = () => {
                            video.play();
                            resolve();
                        };
                    });

                    video.classList.remove('hidden');
                    canvas.classList.add('hidden');
                    openEditor();

                } catch (err) {
                    alert("Camera not supported or permission denied.");
                }
            };

            // ------------------ Confirm ------------------

            useBtn.onclick = () => {

                // Camera capture
                if (cameraStream) {

                    if (!video.videoWidth) {
                        alert("Camera not ready.");
                        return;
                    }

                    const snap = document.createElement("canvas");
                    snap.width = video.videoWidth;
                    snap.height = video.videoHeight;

                    const snapCtx = snap.getContext("2d");
                    snapCtx.drawImage(video, 0, 0);

                    const dataUrl = snap.toDataURL("image/png");

                    stopCamera();

                    video.classList.add("hidden");
                    canvas.classList.remove("hidden");

                    loadImage(dataUrl);
                    return;
                }

                // Normal confirm
                const finalData = canvas.toDataURL("image/png");
                avatar.src = finalData;
                captured.value = finalData;
                closeEditor();
            };

            // ------------------ Controls ------------------

            zoomEl.oninput = () => {
                scale = parseFloat(zoomEl.value);
                draw();
            };

            rotL.onclick = () => {
                rotation -= Math.PI / 2;
                draw();
            };

            rotR.onclick = () => {
                rotation += Math.PI / 2;
                draw();
            };

            canvas.onmousedown = e => {
                dragging = true;
                lastX = e.clientX;
                lastY = e.clientY;
            };

            window.onmouseup = () => dragging = false;

            window.onmousemove = e => {
                if (!dragging) return;
                offsetX += e.clientX - lastX;
                offsetY += e.clientY - lastY;
                lastX = e.clientX;
                lastY = e.clientY;
                draw();
            };

            closeBtn.onclick = closeEditor;
            modal.onclick = e => {
                if (e.target === modal) closeEditor();
            };

                    const dropzone = $('dropzone');

        // Make dropzone clickable
        dropzone.onclick = () => fileInput.click();

        // Drag & drop support
        dropzone.ondragover = e => {
            e.preventDefault();
        };

        dropzone.ondrop = e => {
            e.preventDefault();
            if (e.dataTransfer.files.length > 0) {
                loadFile(e.dataTransfer.files[0]);
            }
        };


        })();
    </script>



}

<style>
    :root {
        --bg: #ffffff;
        --card: #ffffff;
        --muted: #6b7280;
        --text: #111827;
        --border: #e5e7eb;
        --border-default: #d1d5db;
        --border-error: #dc2626;
        --soft: #f9fafb;
        --radius: 14px;
        --shadow: 0 8px 24px rgba(16,24,40,.06);
    }

    /* ================= PAGE ================= */

    html, body {
        background: #fff !important;
    }

    .profile-page {
        width: 100%;
        min-height: calc(100vh - 64px);
        display: flex;
        justify-content: center;
        padding: 20px;
    }

    .profile-card {
        width: 100%;
        max-width: 950px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 28px;
        box-shadow: var(--shadow);
    }

    /* ================= HEADER ================= */

    .profile-title {
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .profile-subtitle {
        color: var(--muted);
        margin-bottom: 20px;
    }

    /* ================= AVATAR BLOCK ================= */

    .avatar-block {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 20px;
        padding: 20px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        margin-bottom: 25px;
    }

    .ap-avatar {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid var(--border-default);
    }

    .dropzone {
        border: 1px dashed #cbd5e1;
        padding: 14px;
        border-radius: var(--radius);
        background: var(--soft);
        cursor: pointer;
    }

    .file-actions {
        margin-top: 12px;
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .file-name {
        font-size: 14px;
        color: var(--muted);
    }

    /* ================= FORM ================= */

    .field {
        margin-bottom: 18px;
    }

    .field-label {
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
    }

    .text-input {
        width: 100%;
        height: 46px;
        padding: 10px 14px;
        border-radius: 14px;
        border: 2px solid var(--border);
        font-size: 14px;
    }

        .text-input:focus {
            border-color: #000;
            outline: none;
        }

        .text-input.input-validation-error {
            border-color: var(--border-error) !important;
        }

    .field-error {
        color: var(--border-error);
        font-size: 13px;
    }

    /* ================= BUTTONS ================= */

    .btn-primary,
    .btn-ghost {
        height: 44px;
        padding: 0 18px;
        border-radius: 999px;
        font-weight: 700;
        cursor: pointer;
        border: 2px solid #000;
        transition: 0.2s;
    }

    .btn-primary {
        background: #000;
        color: #fff;
    }

        .btn-primary:hover {
            background: #fff;
            color: #000;
        }

    .btn-ghost {
        background: #fff;
        color: #000;
    }

        .btn-ghost:hover {
            background: #000;
            color: #fff;
        }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 15px;
    }

    /* ================= HIDDEN FILE INPUT ================= */

    .file-input-hidden {
        position: absolute;
        left: -9999px;
    }

    /* ================= EDITOR MODAL ================= */

    .editor.hidden {
        display: none;
    }

    .editor {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .editor-box {
        background: #fff;
        width: 480px;
        padding: 20px;
        border-radius: 20px;
        position: relative;
    }

    .editor-close {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid #000;
        background: #fff;
        cursor: pointer;
    }

    .editor-stage {
        display: flex;
        justify-content: center;
        margin-bottom: 15px;
    }

    .editor-circle {
        width: 420px;
        height: 420px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid #e5e7eb;
        background: #fff;
    }

    #editorCanvas {
        width: 420px;
        height: 420px;
        display: block;
    }

    .zoom-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .zoom-label {
        font-weight: 700;
        width: 60px;
    }

    #zoom {
        flex: 1;
    }

    .confirm-row {
        display: flex;
        justify-content: center;
        margin-bottom: 10px;
    }

    .btn-confirm {
        background: #000;
        color: #fff;
        border: 2px solid #000;
        border-radius: 999px;
        padding: 8px 22px;
        font-weight: 800;
        cursor: pointer;
    }

        .btn-confirm:hover {
            background: #fff;
            color: #000;
        }

    .rotate-row {
        display: flex;
        justify-content: center;
        gap: 14px;
    }

    .btn-round {
        width: 50px;
        height: 44px;
        border-radius: 999px;
        border: 2px solid #000;
        background: #fff;
        font-weight: 900;
        cursor: pointer;
    }

        .btn-round:hover {
            background: #000;
            color: #fff;
        }

    .hidden {
        display: none !important;
    }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 768px) {
        .avatar-block

    {
        grid-template-columns: 1fr;
    }

    .editor-box {
        width: 95%;
    }

    .editor-circle {
        width: 300px;
        height: 300px;
    }

    #editorCanvas {
        width: 300px;
        height: 300px;
    }

    }
</style>
